#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
.lair/tools/check-linux
.lair/tools/goldens --bin target/native/fugue
python3 -I tools/gameplay.py --bin target/native/fugue
python3 -I tools/gameplay.py --bin target/release/fugue
python3 -I tools/glyphs.py
python3 -I tools/staff-check.py --bin target/native/fugue
python3 -I tools/staff-check.py --bin target/release/fugue
python3 -I tools/species-gameplay.py --bin target/native/fugue
python3 -I tools/species-gameplay.py --bin target/release/fugue

python3 -I tools/pitch-check.py --bin target/native/fugue
python3 -I tools/pitch-check.py --bin target/release/fugue

python3 -I tools/fugue-gameplay.py --bin target/native/fugue
python3 -I tools/fugue-gameplay.py --bin target/release/fugue
target/native/fugue --event-reachable
target/release/fugue --event-reachable
