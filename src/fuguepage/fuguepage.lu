//! The exposition page uses the shared staff and head API without redefining pitch rows.

use answer
use draw
use exposition
use grid
use manuscript
use rhythm
use session
use staff
use subject
use theory
use world

fn text(mut g: grid.Grid, y: int, x: int, words: str, ink: int, bg: int, bold: bool) {
    draw.put_text(mut g, y, x, words, grid.cell(32, ink, bg, if bold then 1 else 0))
}

fn shown(s: session.State, a: subject.Line, b: subject.Line, time: int) -> session.State {
    var out = copy s
    out.cantus = []
    out.voice = []
    out.beats = []
    let span = subject.span(a.beats)
    for bar in 0..span / 8 { (mut out.cantus).push(copy a.notes[rhythm.at(a.beats, bar * 8)]) }
    var at = 0
    while at < span {
        var next = at + 1
        while next < span {
            if rhythm.onset(a.beats, rhythm.at(a.beats, next)) == next ||
                rhythm.onset(b.beats, rhythm.at(b.beats, next)) == next {
                break
            }
            next += 1
        }
        (mut out.voice).push(copy b.notes[rhythm.at(b.beats, at)])
        (mut out.beats).push(rhythm.Beat { length: next - at, rest: false, tied: false })
        at = next
    }
    out.cursor = rhythm.at(out.beats, time)
    out.within = time - rhythm.onset(out.beats, out.cursor)
    out.hearing = -1
    out.cantus_clef = session.choose_clef(a.notes, a.notes)
    out.voice_clef = session.choose_clef(b.notes, b.notes)
    out
}

fn panel_model(
    s: session.State,
    p: exposition.Page,
    findings: List[theory.Break],
) -> staff.PanelData {
    let current = exposition.status(p, s.cursor, s.within, findings)
    let iv = current.interval
    let cls = if iv.consonance == 0 {
        "perfect"
    } else if iv.consonance == 1 {
        "imperfect"
    } else {
        "dissonant"
    }
    var local = List[staff.PanelFinding](), shown = List[staff.PanelFinding]()
    for b in current.local { (mut local).push(staff.PanelFinding { bar: b.bar, rule: b.rule }) }
    for b in current.findings { (mut shown).push(staff.PanelFinding { bar: b.bar, rule: b.rule }) }
    staff.PanelData {
        bar: current.bar,
        beat: current.beat,
        interval: if s.beats[s.cursor].rest then "rest" else "{iv.quality}{iv.number} {cls}",
        consonance: iv.consonance,
        pitch: theory.name(current.pitch),
        figure: current.figure,
        strong: current.beat == 1,
        allowed: current.allowed,
        local: local,
        findings: shown,
        notice: s.notice,
    }
}

fn voice(
    mut g: grid.Grid,
    v: staff.Viewport,
    layout: session.State,
    line: subject.Line,
    start: int,
    t: int,
    given: bool,
    selected: int,
    lit: int,
) {
    let bg = if t == 1 then 230 else 7
    let ink = if given then staff.cantus_ink(t) else staff.player_ink(t)
    for i in 0..line.notes.len {
        let time = rhythm.onset(line.beats, i)
        if time / 8 < start { continue }
        let event = rhythm.at(layout.beats, time)
        let x = manuscript.event_column(layout, start, event)
        if x + manuscript.event_width(layout, event) - 2 >= g.cols - 27 { break }
        let nx = x - (if given then 1 else 0)
        if line.beats[i].rest {
            text(
                mut g,
                staff.row_of(v, theory.pitch(v.voice_line + 4)),
                nx,
                "r",
                ink,
                bg,
                selected == i,
            )
        } else {
            let y = staff.head(mut g, v, line.notes[i], nx, t, given, selected == i, lit == i)
            if y >= v.top && y <= v.bottom {
                if line.beats[i].length < 8 {
                    let stem = if line.beats[i].length == 4 || line.beats[i].length == 6 {
                        2
                    } else {
                        3
                    }
                    let d = if y < v.top + stem then 1 else -1
                    for n in 1..stem + 1 {
                        if y + d * n >= v.top && y + d * n <= v.bottom {
                            text(mut g, y + d * n, nx + 1, "|", ink, bg, false)
                        }
                    }
                    if line.beats[i].length == 1 {
                        text(mut g, y + d * stem, nx + 2, "'", ink, bg, false)
                    }
                    if line.beats[i].length == 3 || line.beats[i].length == 6 {
                        text(mut g, y, nx + 2, ".", ink, bg, false)
                    }
                }
                if line.beats[i].tied && y < v.bottom {
                    text(mut g, y + 1, nx - 1, "~", ink, bg, false)
                }
            }
        }
    }
}

/// Entry labels, the independent verdict and the last-book end card.
pub fn frame(s: session.State, cols: int, rows: int, t: int) -> grid.Grid {
    var g = grid.new(rows, cols)
    let bg = if t == 1 then 230 else 7, ink = if t == 1 then 94 else 3, blue = staff.player_ink(t)
    for y in 0..rows {
        for x in 0..cols {
            let grain = world.hash(s.seed, y, x, 256)
            grid.put(
                mut g,
                y,
                x,
                grid.cell(
                    if grain < 2 then (if t == 1 then 0x00b7 else 46) else 32,
                    if t == 1 then 180 else 3,
                    if t == 1 && grain < 15 then 223 else bg,
                    0,
                ),
            )
        }
    }
    text(mut g, 1, 3, "fugue / VI. The fugue", blue, bg, true)
    if s.failure != "" {
        text(mut g, 6, 4, s.failure, blue, bg, true)
        text(mut g, 8, 4, "n another seed   b books   q quit", ink, bg, false)
        return g
    }
    let p = exposition.written(s.fugue, s.voice, s.beats)
    let av = answer.check(p.given, p.response.notes, p.response.beats, p.answer_below)
    let verdict = exposition.check(p)
    if s.phase == 4 {
        text(mut g, 5, 6, "THE FUGUE", blue, bg, true)
        text(mut g, 8, 6, "A voice learned to answer. Two learned to trade places.", ink, bg, false)
        text(mut g, 10, 6, "Three tutorial pieces written.", blue, bg, true)
        text(
            mut g,
            12,
            6,
            "Stars: {s.completed[0]} + {s.completed[1]} + {s.completed[2]} = {s.completed[0] + s.completed[1] + s.completed[2]} / 9",
            blue,
            bg,
            true,
        )
        text(mut g, 15, 6, "The sixth book is lit. The next page is yours.", ink, bg, false)
        text(
            mut g,
            rows - 3,
            6,
            "n seeded page   b the six books   q close the cover",
            blue,
            bg,
            false,
        )
        return g
    }
    if s.phase == 2 {
        text(
            mut g,
            4,
            4,
            "{if verdict.stars > 0 then "Legal exposition" else "Not yet"}    {verdict.stars} / 3 stars",
            blue,
            bg,
            true,
        )
        text(mut g, 6, 4, av.kind, blue, bg, true)
        if av.mutation >= 0 {
            text(
                mut g,
                7,
                4,
                "Tonal mutation: head attack {av.mutation + 1}, bar {rhythm.onset(p.given.beats, av.mutation) / 8 + 1}",
                ink,
                bg,
                false,
            )
        }
        text(
            mut g,
            8,
            4,
            "Contrary {verdict.contrary}%  Steps {verdict.steps}%  Intervals {verdict.variety}",
            ink,
            bg,
            false,
        )
        text(
            mut g,
            9,
            4,
            "Climaxes apart {verdict.separate_climax}  Short parallels {verdict.parallel_limit}",
            ink,
            bg,
            false,
        )
        for row in 0..rows - 14 {
            let i = s.cursor + row
            if i < verdict.breaks.len {
                let b = copy verdict.breaks[i]
                text(
                    mut g,
                    11 + row,
                    4,
                    draw.fit("Bar {b.bar}: {b.rule} / {b.reason}", cols - 8, false),
                    staff.harmony_ink(2, t),
                    bg,
                    false,
                )
            }
        }
        if verdict.breaks.len == 0 {
            text(
                mut g,
                12,
                4,
                "The countersubject holds both above and below the answer.",
                ink,
                bg,
                false,
            )
        }
        text(
            mut g,
            rows - 2,
            4,
            "r edit   n next   b books   Up/Down findings   q quit",
            blue,
            bg,
            false,
        )
        return g
    }
    let bars = exposition.bars(p), duration = bars * session.ticks_per_whole()
    let solo = s.hearing >= 0 && s.hearing < duration
    let answer_desk = s.hearing < 0 && p.editing == 0
    let local_time = if s.hearing >= 0 {
        s.hearing % duration * 8 / session.ticks_per_whole()
    } else {
        rhythm.onset(s.beats, s.cursor) + s.within
    }
    let first = if solo || answer_desk then copy p.given else copy p.response
    let second = if solo {
        copy p.given
    } else if answer_desk {
        copy p.response
    } else {
        copy p.continuation
    }
    let layout = shown(s, first, second, local_time)
    let start = manuscript.first_bar(layout, cols), margin = cols - 24
    var low = 100, high = 0
    for line in [copy first, copy second] {
        for note in line.notes {
            let pos = theory.position(note)
            if pos < low { low = pos }
            if pos > high { high = pos }
        }
    }
    var top = if rows == 24 then 4 else 5 + (rows - 24) / 2
    var bottom = rows - 4
    if high - low > bottom - top && rows == 24 { top = 1; bottom = 21 }
    let height = bottom - top
    var minimum = high - height
    if minimum < s.clef + 8 - height { minimum = s.clef + 8 - height }
    let maximum = if low < s.clef then low else s.clef
    var base = s.clef - 5
    if base < minimum { base = minimum }
    if base > maximum { base = maximum }
    let v = staff.system(layout, take staff.viewport(top, bottom, base, 7, margin - 2))
    if v.top == 1 { for y in 0..4 { text(mut g, y, 0, " ".repeat(margin), ink, bg, false) } }
    var boundaries = List[int]()
    for bar in start..bars {
        let event = rhythm.at(layout.beats, bar * 8)
        let x = manuscript.event_column(layout, start, event)
        if x >= cols - 27 { break }
        (mut boundaries).push(x - 2)
    }
    (mut boundaries).push(margin - 2)
    staff.draw_staff(mut g, v, t, boundaries)
    for bar in start..bars {
        let event = rhythm.at(layout.beats, bar * 8),
            x = manuscript.event_column(layout, start, event)
        if x >= cols - 27 { break }
        text(
            mut g,
            v.top - 1,
            x - (if bar + 1 + (if s.hearing >= duration then bars else 0) >= 10 then 2 else 1),
            "{bar + 1 + (if s.hearing >= duration then bars else 0)}",
            ink,
            bg,
            true,
        )
    }
    let lit_a = if s.hearing >= 0 then rhythm.at(first.beats, local_time) else -1
    let lit_b = if s.hearing >= duration then rhythm.at(second.beats, local_time) else -1
    voice(mut g, v, layout, first, start, t, true, -1, lit_a)
    if !solo {
        voice(
            mut g,
            v,
            layout,
            second,
            start,
            t,
            false,
            if s.hearing < 0 then s.cursor else -1,
            lit_b,
        )
    }
    for event in 0..layout.beats.len {
        let time = rhythm.onset(layout.beats, event)
        if time / 8 < start { continue }
        let x = manuscript.event_column(layout, start, event)
        if x + manuscript.event_width(layout, event) - 2 >= cols - 27 {
            text(mut g, v.top - 1, margin - 5, ">>", blue, bg, true)
            break
        }
        if solo {
            let a = rhythm.at(first.beats, time)
            let iy = staff.interval_row(v, first.notes[a], first.notes[a], first.beats[a].tied)
            text(
                mut g,
                iy,
                x - 1,
                "/{rhythm.value_name(first.beats[a].length)}",
                staff.cantus_ink(t),
                bg,
                false,
            )
        } else {
            let a = rhythm.at(first.beats, time), b = rhythm.at(second.beats, time)
            let iv = theory.interval(first.notes[a], second.notes[b])
            let iy = staff.interval_row(v, first.notes[a], second.notes[b], second.beats[b].tied)
            text(
                mut g,
                iy,
                x - 1,
                if first.beats[a].rest || second.beats[b].rest {
                    "r"
                } else {
                    "{if time % 8 == 0 then "S" else "w"}{iv.quality}{iv.number}"
                },
                staff.harmony_ink(iv.consonance, t),
                bg,
                false,
            )
            if iy + 1 < rows - 2 {
                text(
                    mut g,
                    iy + 1,
                    x - 1,
                    "/{rhythm.value_name(second.beats[b].length)}",
                    blue,
                    bg,
                    false,
                )
            }
        }
    }
    let focus = layout.cursor
    let caret_x = manuscript.event_column(layout, start, focus)
    if caret_x + manuscript.event_width(layout, focus) - 2 < cols - 27 {
        let a = rhythm.at(first.beats, local_time), b = rhythm.at(second.beats, local_time)
        let lower = staff.interval_row(v, first.notes[a], second.notes[b], second.beats[b].tied) + 2
        let caret_y = if lower < rows - 2 then lower else v.top - 1
        let offset = if s.hearing >= 0 then 0 else layout.within / session.editor_unit(layout)
        text(mut g, caret_y, caret_x + offset, "^", blue, bg, true)
    }
    staff.panel_data(mut g, panel_model(s, p, verdict.breaks), margin, t)
    text(
        mut g,
        1,
        margin + 2,
        if s.hearing >= 0 {
            "VI. The fugue"
        } else if p.editing == 0 {
            "Answer desk"
        } else {
            "Countersubject desk"
        },
        blue,
        bg,
        true,
    )
    text(
        mut g,
        2,
        margin + 2,
        if solo {
            "Subject"
        } else if s.hearing >= duration {
            "Answer+Countersubject"
        } else if p.editing == 0 {
            "Subject+Answer"
        } else {
            "Answer+Countersubject"
        },
        blue,
        bg,
        true,
    )
    let hint = if v.grand && rows == 24 then rows - 1 else rows - 2
    text(
        mut g,
        hint,
        2,
        if s.rhythm_editable {
            "[ ] . t r rhythm  Arrows/# pitch  v voice  h hear  Enter check  n b q"
        } else if s.level >= 2 {
            "Arrows/# pitch   v voice   h exposition   Enter check   n next b q"
        } else {
            "Arrows/# pitch   h exposition   Enter check   n next   b books   q quit"
        },
        blue,
        bg,
        false,
    )
    g
}
