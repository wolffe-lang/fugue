use answer
use counter
use rhythm
use subject
use theory

fn named(breaks: List[theory.Break], rule: str) -> bool {
    for b in breaks { if b.rule == rule { return true } }
    false
}

fn test_invertible_references_earn_three_stars_both_ways() {
    for index in 0..3 {
        let s = subject.tutorial(index), cs = counter.reference(index)
        assert(subject.validate(s).len == 0)
        for below in [false, true] {
            let a = answer.make(s, below, index == 2)
            let v = counter.check(a, cs, below, !below)
            if v.stars != 3 { print("reference {index} below {below} {v}") }
            assert(v.stars == 3)
            assert(answer.check(s, a.notes, a.beats, below).breaks.len == 0)
        }
    }
}

fn test_inversion_fifth_is_never_accepted() {
    let a = answer.make(subject.tutorial(0), false, false)
    var cs = counter.octave(counter.reference(0), 1)
    cs.notes[0] = theory.pitch(theory.position(a.notes[0]) + 4)
    let v = counter.check(a, cs, false, false)
    assert(v.stars == 0)
    assert(named(v.breaks, "inversion-fifth"))
    assert(named(v.breaks, "inverted-downbeat-consonance"))
}

fn test_counter_rules_reject_named_mutations() {
    let a = answer.make(subject.tutorial(0), false, false)
    let good = counter.octave(counter.reference(0), 1)
    var cs = copy good
    cs.notes[3] = theory.pitch(theory.position(a.notes[3]) - 1)
    assert(named(counter.check(a, cs, false, false).breaks, "crossing"))
    cs = copy good
    cs.notes[3].octave += 2
    assert(named(counter.check(a, cs, false, false).breaks, "inversion-span"))
    cs = copy good
    cs.beats[2].tied = true
    assert(named(counter.check(a, cs, false, false).breaks, "tie-pitch"))
    cs = copy good
    cs.beats[0].length = 1
    assert(named(counter.check(a, cs, false, false).breaks, "counter-rhythm"))
    cs = copy good
    cs.notes[2] = copy cs.notes[1]
    assert(named(counter.check(a, cs, false, false).breaks, "repeat"))
    cs = copy good
    cs.notes[4].accidental = 1
    assert(named(counter.check(a, cs, false, false).breaks, "diatonic"))
}

fn test_counter_search_certifies_its_output() {
    let a = answer.make(subject.tutorial(0), false, false)
    let proof = counter.solve(a, false) else { assert(false); return }
    assert(counter.check(a, proof, false, false).stars == 3)
}

fn test_moving_answer_is_checked_between_counter_attacks() {
    var a = subject.tutorial(0), b = subject.tutorial(0)
    a.notes = [theory.pitch(28), theory.pitch(29), theory.pitch(30)]
    a.beats = [
        rhythm.Beat { length: 4, rest: false, tied: false },
        rhythm.Beat { length: 4, rest: false, tied: false },
        rhythm.Beat { length: 8, rest: false, tied: false },
    ]
    b.notes = [theory.pitch(30), theory.pitch(32)]
    b.beats = rhythm.pattern(1, 2)
    assert(counter.classify(b, a, 1, true) == "passing")
    assert(counter.pair(a, b, false).len == 0)
    a.notes[1] = theory.pitch(27)
    assert(counter.classify(b, a, 1, true) == "unlicensed")
    assert(named(counter.pair(a, b, false), "florid-dissonance"))
}

fn test_parallel_perfects_on_moving_timeline_are_refused() {
    var a = subject.tutorial(0), b = subject.tutorial(0)
    a.notes = [theory.pitch(28), theory.pitch(29)]
    b.notes = [theory.pitch(32), theory.pitch(33)]
    a.beats = rhythm.pattern(1, 2)
    b.beats = rhythm.pattern(1, 2)
    assert(named(counter.pair(a, b, false), "parallel-perfect"))
    assert(named(counter.pair(a, b, false), "accented-parallel"))
}

fn figure(cf: List[int], cp: List[int], beats: List[rhythm.Beat], i: int, below: bool) -> str {
    var a = subject.Line { notes: [], beats: rhythm.pattern(1, cf.len), mode: 0 }
    var b = subject.Line { notes: [], beats: copy beats, mode: 0 }
    for pos in cf { (mut a.notes).push(theory.pitch(pos)) }
    for pos in cp { (mut b.notes).push(theory.pitch(pos)) }
    counter.classify(a, b, i, below)
}

fn test_moving_voice_classifier_retains_all_florid_figures() {
    let quarters = rhythm.pattern(3, 2), tied = rhythm.pattern(4, 3)
    assert(figure([28, 28], [30, 31, 30, 32, 35], quarters, 1, false) == "neighbour")
    assert(figure([28, 28], [30, 31, 32, 33, 35], quarters, 1, false) == "double-passing")
    assert(figure([28, 29], [35, 34, 32, 33, 34], quarters, 1, false) == "cambiata")
    assert(figure([35, 34], [28, 29, 31, 30, 29], quarters, 1, true) == "cambiata")
    assert(figure([28, 29], [35, 34, 31, 33, 34], quarters, 1, false) == "unlicensed")
    assert(figure([28, 29, 28], [35, 35, 35, 34, 35], tied, 2, false) == "suspension")
    assert(figure([30, 29, 28], [28, 28, 28, 27, 28], tied, 2, true) == "suspension")
    assert(figure([28, 29, 28], [35, 35, 35, 36, 35], tied, 2, false) == "unprepared")
    assert(figure([28, 29, 28], [35, 34, 35, 34, 35], tied, 2, false) == "unprepared")
    var eighths = List[rhythm.Beat]()
    for value in [4, 2, 1, 1, 8] { (mut eighths).push(rhythm.Beat { length: value, rest: false, tied: false }) }
    assert(figure([28, 28], [35, 32, 33, 34, 35], eighths, 2, false) == "eighth-pair")
    assert(figure([28, 28], [35, 31, 33, 34, 35], eighths, 2, false) == "unlicensed-eighth")
}

fn test_open_counterphrase_does_not_borrow_a_false_cadence_accidental() {
    var cs = counter.reference(0)
    cs.mode = 1
    cs.notes[8] = theory.pitch(32)
    cs.notes[8].accidental = 1
    cs.notes[9] = theory.pitch(34)
    assert(named(counter.melody(cs, false), "diatonic"))
    cs.notes[9] = theory.pitch(33)
    assert(!named(counter.melody(cs, false), "diatonic"))
    cs.mode = 5
    cs.notes[7] = theory.pitch(35)
    cs.notes[7].accidental = 1
    cs.notes[8] = theory.pitch(36)
    cs.notes[8].accidental = 1
    cs.notes[9] = theory.pitch(37)
    assert(!named(counter.melody(cs, false), "diatonic"))
}
