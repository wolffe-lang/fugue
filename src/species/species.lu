//! Rhythmic counterpoint: every sounding event is checked independently.

use first
use rhythm
use theory

fn delta(a: theory.Pitch, b: theory.Pitch) -> int { theory.position(b) - theory.position(a) }

/// A passing note has a step in and a step out in the same direction.
pub fn passing(cp: List[theory.Pitch], beats: List[rhythm.Beat], i: int) -> bool {
    if i == 0 || i + 1 >= cp.len || beats[i - 1].rest || beats[i + 1].rest { return false }
    let a = delta(cp[i - 1], cp[i]), b = delta(cp[i], cp[i + 1])
    theory.magnitude(a) == 1 && a == b
}

/// Neighbours leave and return by opposite steps, never a leap.
pub fn neighbour(cp: List[theory.Pitch], beats: List[rhythm.Beat], i: int) -> bool {
    if i == 0 || i + 1 >= cp.len || beats[i - 1].rest || beats[i + 1].rest { return false }
    let a = delta(cp[i - 1], cp[i]), b = delta(cp[i], cp[i + 1])
    theory.magnitude(a) == 1 && a == -b
}

/// The five-note cambiata: step, descending third, two returning steps.
/// The lower voice uses its mirror. The leap lands on a consonance.
pub fn cambiata(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    i: int,
    below: bool,
) -> bool {
    if i == 0 || i + 3 >= cp.len || i + 3 >= beats.len { return false }
    let start = rhythm.onset(beats, i - 1)
    if start % 8 != 0 || start / 8 >= cf.len { return false }
    if theory.interval(cf[start / 8], cp[i]).consonance != 2 { return false }
    let dir = if below then 1 else -1
    if delta(cp[i - 1], cp[i]) != dir ||
        delta(cp[i], cp[i + 1]) != dir * 2 ||
        delta(cp[i + 1], cp[i + 2]) != -dir ||
        delta(cp[i + 2], cp[i + 3]) != -dir {
        return false
    }
    for j in i - 1..i + 4 {
        if beats[j].rest || beats[j].tied { return false }
        if j < i + 3 && beats[j].length != 2 { return false }
        let bar = rhythm.onset(beats, j) / 8
        if bar >= cf.len { return false }
        if j != i && theory.interval(cf[bar], cp[j]).consonance == 2 { return false }
    }
    true
}

/// Two intervening quarters connect consonant endpoints by three steps.
pub fn double_passing(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    i: int,
) -> bool {
    for offset in 1..3 {
        let start = i - offset
        if start < 0 || start + 3 >= cp.len { continue }
        if rhythm.onset(beats, start) % 8 != 0 { continue }
        let dir = delta(cp[start], cp[start + 1])
        if theory.magnitude(dir) != 1 { continue }
        var good = true
        for j in start..start + 4 {
            if beats[j].rest || beats[j].tied || beats[j].length != 2 { good = false }
            if j > start && delta(cp[j - 1], cp[j]) != dir { good = false }
        }
        let bar = rhythm.onset(beats, start) / 8
        if bar >= cf.len { continue }
        if theory.interval(cf[bar], cp[start]).consonance == 2 ||
            theory.interval(cf[bar], cp[start + 3]).consonance == 2 {
            good = false
        }
        if good { return true }
    }
    false
}

/// Prepared dissonance tied over the bar and resolved down one step.
pub fn suspension(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    i: int,
    below: bool,
) -> bool {
    if i == 0 || i + 1 >= cp.len || i + 1 >= beats.len { return false }
    let time = rhythm.onset(beats, i), bar = time / 8
    if time % 8 != 0 || bar == 0 || bar >= cf.len { return false }
    if !beats[i].tied ||
        beats[i].rest ||
        beats[i - 1].rest ||
        beats[i + 1].rest ||
        beats[i + 1].tied {
        return false
    }
    if beats[i].length != 4 || beats[i - 1].length != 4 || beats[i + 1].length != 4 { return false }
    if theory.chromatic(cp[i - 1]) != theory.chromatic(cp[i]) || delta(cp[i - 1], cp[i]) != 0 {
        return false
    }
    if theory.interval(cf[bar - 1], cp[i - 1]).consonance == 2 { return false }
    if delta(cp[i], cp[i + 1]) == 1 { return true }
    if delta(cp[i], cp[i + 1]) != -1 ||
        theory.magnitude(theory.chromatic(cp[i + 1]) - theory.chromatic(cp[i])) > 2 {
        return false
    }
    let held = theory.interval(cf[bar], cp[i]), resolved = theory.interval(cf[bar], cp[i + 1])
    if held.consonance != 2 ||
        resolved.consonance == 2 ||
        held.quality == "A" ||
        held.quality == "d" {
        return false
    }
    if below { return held.number == 2 && resolved.number == 3 }
    held.number == 7 && resolved.number == 6 ||
        held.number == 4 && resolved.number == 3 ||
        held.number == 9 && resolved.number == 8
}

/// Parallel perfects include compound equivalents and require motion in both voices.
pub fn parallel(a: theory.Pitch, b: theory.Pitch, c: theory.Pitch, d: theory.Pitch) -> bool {
    let old = theory.interval(a, b), next = theory.interval(c, d)
    let x = theory.chromatic(c) - theory.chromatic(a), y = theory.chromatic(d) - theory.chromatic(b)
    old.consonance == 0 &&
        next.consonance == 0 &&
        (old.number - 1) % 7 == (next.number - 1) % 7 &&
        x != 0 &&
        y != 0 &&
        theory.direction(x) == theory.direction(y)
}

/// Paired eighths occupy a weak quarter and move by step in, through and out.
pub fn eighth_pair(cp: List[theory.Pitch], beats: List[rhythm.Beat], i: int) -> bool {
    if i >= beats.len || beats[i].length != 1 { return false }
    let time = rhythm.onset(beats, i)
    let start = if time % 2 == 0 then i else i - 1
    if start < 1 || start + 2 >= cp.len || start + 2 >= beats.len { return false }
    let offset = rhythm.onset(beats, start) % 8
    if offset != 2 && offset != 6 { return false }
    if beats[start].length != 1 || beats[start + 1].length != 1 { return false }
    for j in start..start + 2 { if beats[j].rest || beats[j].tied { return false } }
    for j in start..start + 3 {
        if beats[j].rest || beats[j - 1].rest || theory.magnitude(delta(cp[j - 1], cp[j])) != 1 {
            return false
        }
    }
    true
}

/// Duration variety and tied duration share are visible, not hidden bonuses.
pub fn rhythm_style(beats: List[rhythm.Beat]) -> (int, int) {
    var mask: int = 0
    var total = 0, tied = 0, variety = 0
    for b in beats {
        if !b.rest {
            mask |= 1 << b.length
            total += b.length
            if b.tied { tied += b.length }
        }
    }
    for value in [1, 2, 4, 8] { if mask & 1 << value != 0 { variety += 1 } }
    (variety, if total > 0 then tied * 100 / total else 0)
}

/// Classifier precedence is rhythmic, not a special exemption in the verdict.
pub fn classify(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    i: int,
    book: int,
    below: bool,
) -> str {
    if i < 0 || i >= cp.len || beats.len != cp.len { return "invalid" }
    let time = rhythm.onset(beats, i)
    if time / 8 >= cf.len { return "invalid" }
    if beats[i].rest { return "rest" }
    if beats[i].length == 1 {
        if book != 5 || !eighth_pair(cp, beats, i) { return "unlicensed-eighth" }
        let consonant = theory.interval(cf[time / 8], cp[i]).consonance != 2
        if consonant || passing(cp, beats, i) || neighbour(cp, beats, i) { return "eighth-pair" }
        return "unlicensed"
    }
    if theory.interval(cf[time / 8], cp[i]).consonance != 2 { return "consonance" }
    if time % 8 == 0 {
        if (book == 4 || book == 5) && suspension(cf, cp, beats, i, below) { return "suspension" }
        return "unprepared"
    }
    if book >= 3 && book != 4 {
        if cambiata(cf, cp, beats, i, below) { return "cambiata" }
        if double_passing(cf, cp, beats, i) { return "double-passing" }
        if neighbour(cp, beats, i) { return "neighbour" }
    }
    if book >= 2 && book != 4 && passing(cp, beats, i) { return "passing" }
    "unlicensed"
}

fn blank() -> first.Verdict {
    first.Verdict {
        breaks: List[theory.Break](),
        stars: 0,
        contrary: 0,
        steps: 0,
        separate_climax: false,
        parallel_limit: true,
        variety: 0,
    }
}

/// Local vertical, rhythm and motion rules; safe for prefix pruning.
pub fn vertical(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    below: bool,
    book: int,
    complete: bool,
) -> List[theory.Break] {
    var out = List[theory.Break]()
    if cp.len > beats.len {
        theory.require(mut out, false, 1, "voice-length", "Every note needs a value.")
        return out
    }
    var last = -1, first_note = true
    for i in 0..cp.len {
        let time = rhythm.onset(beats, i), bar = time / 8
        if bar >= cf.len {
            theory.require(
                mut out,
                false,
                bar + 1,
                "voice-length",
                "End together with the given voice.",
            )
            return out
        }
        let b = copy beats[i]
        if book == 5 && b.length == 1 && (complete || i + 2 < cp.len) {
            theory.require(
                mut out,
                eighth_pair(cp, beats, i),
                bar + 1,
                "paired-eighths",
                "Pair eighths on a weak quarter; walk into, through and out of the pair.",
            )
        }
        let ending = bar == cf.len - 1
        theory.require(
            mut out,
            book == 5 && !ending || b.length == (if ending then 8 else if book == 3 then 2 else 4),
            bar + 1,
            if book == 3 then "third-rhythm" else "second-rhythm",
            "Use this book's equal subdivisions, then a whole at the close.",
        )
        theory.require(
            mut out,
            !b.tied || book == 4 || book == 5,
            bar + 1,
            "second-tie",
            "In this book, strike each half anew.",
        )
        if b.rest {
            theory.require(
                mut out,
                i == 0 && b.length == 4,
                bar + 1,
                "opening-rest",
                "Only the opening half may be silent.",
            )
            continue
        }
        if b.tied {
            let valid_tie = i > 0 &&
                time % 8 == 0 &&
                !beats[i - 1].rest &&
                theory.chromatic(cp[i - 1]) == theory.chromatic(cp[i]) &&
                delta(cp[i - 1], cp[i]) == 0
            theory.require(
                mut out,
                valid_tie,
                bar + 1,
                "tie-pitch",
                "A tie carries the same sounding pitch across the bar.",
            )
        }
        let iv = theory.interval(cf[bar], cp[i])
        let c = theory.chromatic(cf[bar]), p = theory.chromatic(cp[i])
        theory.require(
            mut out,
            if below then p <= c else p >= c,
            bar + 1,
            "crossing",
            "Keep the voices on their own sides.",
        )
        if first_note {
            theory.require(
                mut out,
                iv.quality == "P" && (iv.number == 8 || iv.number == (if below then 1 else 5)),
                bar + 1,
                "opening",
                "Begin on a perfect interval allowed for this voice.",
            )
            first_note = false
        }
        if time % 8 == 0 {
            theory.require(
                mut out,
                iv.consonance != 2 ||
                    (book == 4 || book == 5) &&
                        (!complete && i + 1 >= cp.len || suspension(cf, cp, beats, i, below)),
                bar + 1,
                if book == 4 then "suspension" else "downbeat-consonance",
                "Let the strong beat stand on a consonance.",
            )
            theory.require(
                mut out,
                iv.number != 1 || bar == 0 || ending,
                bar + 1,
                "downbeat-unison",
                "Reserve a strong-beat unison for the edges.",
            )
        } else if iv.consonance == 2 &&
            (complete || i + (if book == 3 || book == 5 then 3 else 1) < cp.len) {
            theory.require(
                mut out,
                book != 4 &&
                    (
                        passing(cp, beats, i) ||
                            (book == 3 || book == 5) &&
                                (
                                    neighbour(cp, beats, i) ||
                                        double_passing(cf, cp, beats, i) ||
                                        cambiata(cf, cp, beats, i, below)
                                )
                    ),
                bar + 1,
                if book == 3 then "third-dissonance" else "passing-dissonance",
                "Give the dissonance a complete passing, neighbour or cambiata figure allowed in this book.",
            )
        }
        if last >= 0 {
            let old_bar = rhythm.onset(beats, last) / 8
            let old_c = theory.chromatic(cf[old_bar]), old_p = theory.chromatic(cp[last])
            theory.require(
                mut out,
                !(if below then p > old_c || c < old_p else p < old_c || c > old_p),
                bar + 1,
                "overlap",
                "Do not pass the other voice's last sounding pitch.",
            )
            let par = parallel(cf[old_bar], cp[last], cf[bar], cp[i])
            theory.require(
                mut out,
                !par,
                bar + 1,
                "parallel-perfect",
                "Perfect intervals must not travel in parallel.",
            )
            let same = c != old_c &&
                p != old_p &&
                theory.direction(c - old_c) == theory.direction(p - old_p)
            theory.require(
                mut out,
                !same || iv.consonance != 0 || par,
                bar + 1,
                "hidden-perfect",
                "Turn a voice on the way into a perfect interval.",
            )
        }
        if bar > 0 && time % 8 == 0 {
            let old = rhythm.at(beats, time - 8)
            if old < cp.len && !beats[old].rest {
                theory.require(
                    mut out,
                    !parallel(cf[bar - 1], cp[old], cf[bar], cp[i]),
                    bar + 1,
                    "accented-parallel",
                    "The downbeats still count: do not hide parallel perfects between them.",
                )
            }
        }
        if (book == 3 || book == 5) && bar > 0 && time % 8 != 0 {
            let old = rhythm.at(beats, time - 8)
            if old < cp.len && !beats[old].rest {
                theory.require(
                    mut out,
                    !parallel(cf[bar - 1], cp[old], cf[bar], cp[i]),
                    bar + 1,
                    "same-beat-parallel",
                    "Listen across bars too: equal beats must not carry parallel perfects.",
                )
            }
        }
        last = i
    }
    out
}

/// Complete line: melodic canon over attacks, cadence over the final weak beat.
pub fn check(
    cf: List[theory.Pitch],
    cp: List[theory.Pitch],
    beats: List[rhythm.Beat],
    mode: int,
    below: bool,
    book: int,
) -> first.Verdict {
    var v = blank()
    if cf.len < 2 || cp.len != beats.len || !rhythm.valid(beats, cf.len) {
        theory.require(
            mut v.breaks,
            false,
            1,
            "voice-length",
            "Fill each cantus bar, and close together.",
        )
        return v
    }
    v.breaks = vertical(cf, cp, beats, below, book, true)
    var line = List[theory.Pitch](), times = List[int]()
    for i in 0..cp.len {
        if !beats[i].rest && !beats[i].tied {
            (mut line).push(copy cp[i])
            (mut times).push(rhythm.onset(beats, i))
        }
    }
    if line.len < 2 {
        theory.require(
            mut v.breaks,
            false,
            1,
            "attacks",
            "Give the voice a beginning and an ending.",
        )
        return v
    }
    let n = cp.len
    let last = theory.interval(cf[cf.len - 1], cp[n - 1])
    theory.require(
        mut v.breaks,
        !beats[n - 1].rest && last.quality == "P" && (last.number == 1 || last.number == 8),
        cf.len,
        "closing",
        "Close together on a unison or octave.",
    )
    let penult = theory.interval(cf[cf.len - 2], cp[n - 2])
    let approach = theory.magnitude(delta(cp[n - 2], cp[n - 1])) == 1 &&
        theory.magnitude(delta(cf[cf.len - 2], cf[cf.len - 1])) == 1
    let shape = last.number == 8 && penult.number == 6 && penult.quality == "M" ||
        last.number == 1 && penult.number == 3 && penult.quality == "m" ||
        below && last.number == 8 && penult.number == 10 && penult.quality == "m"
    theory.require(
        mut v.breaks,
        approach && shape,
        cf.len - 1,
        "two-voice-cadence",
        "Let the last weak beat be a major sixth opening out, or a minor third closing in.",
    )
    if book == 4 {
        let pen = rhythm.at(beats, (cf.len - 2) * 8)
        let held = theory.interval(cf[cf.len - 2], cp[pen])
        theory.require(
            mut v.breaks,
            suspension(cf, cp, beats, pen, below) && held.number == (if below then 2 else 7),
            cf.len - 1,
            "suspension-cadence",
            "Let a prepared seventh fall to a sixth above, or a second open to a third below, before the close.",
        )
    }
    theory.require(
        mut v.breaks,
        theory.leaps(line) >= 2 && theory.leaps(line) <= leap_limit(line.len),
        1,
        "leap-count",
        "Use at least two leaps, and at most four per ten attacks rounded up; let steps do the rest.",
    )
    var normalized = List[theory.Pitch]()
    let shift = (line[line.len - 1].octave - 4) * 7
    for p in line {
        var q = theory.pitch(theory.position(p) - shift)
        q.accidental = p.accidental
        (mut normalized).push(q)
    }
    for b in theory.validate(normalized, mode) {
        if b.rule == "diatonic" && cadential_sixth(normalized, mode, b.bar - 1) { continue }
        if b.rule != "length" &&
            b.rule != "leap-count" &&
            b.rule != "final" &&
            b.rule != "cadence" {
            var finding = copy b
            if b.bar > 0 && b.bar <= times.len { finding.bar = times[b.bar - 1] / 8 + 1 }
            (mut v.breaks).push(finding)
        }
    }
    var high = -1,
        peaks = 0,
        peak = 0,
        cf_high = -1,
        cf_peak = 0,
        contrary = 0,
        changes = 0,
        steps = 0
    var seen: int = 0
    var run = 1
    for i in 0..cf.len {
        if theory.chromatic(cf[i]) > cf_high { cf_high = theory.chromatic(cf[i]); cf_peak = i }
    }
    for i in 0..line.len {
        let p = theory.chromatic(line[i]), bar = times[i] / 8
        if p > high {
            high = p
            peak = bar
            peaks = 1
        } else if p == high {
            peaks += 1
        }
        let iv = theory.interval(cf[bar], line[i])
        seen |= 1 << (iv.number - 1) % 7 + 1
        if i > 0 {
            if theory.magnitude(delta(line[i - 1], line[i])) == 1 { steps += 1 }
        }
    }
    for i in 1..cp.len {
        if beats[i].rest || beats[i - 1].rest || beats[i].tied { continue }
        let old_bar = rhythm.onset(beats, i - 1) / 8, bar = rhythm.onset(beats, i) / 8
        if old_bar != bar && theory.chromatic(cp[i - 1]) != theory.chromatic(cp[i]) {
            changes += 1
            if theory.motion(cf[old_bar], cp[i - 1], cf[bar], cp[i]) == "contrary" { contrary += 1 }
        }
    }
    for bar in 1..cf.len {
        let i = rhythm.at(beats, bar * 8), j = rhythm.at(beats, (bar - 1) * 8)
        let a = theory.interval(cf[bar], cp[i]), b = theory.interval(cf[bar - 1], cp[j])
        if a.number == b.number &&
            (a.number % 7 == 3 || a.number % 7 == 6) &&
            theory.motion(cf[bar - 1], cp[j], cf[bar], cp[i]) == "parallel" {
            run += 1
        } else {
            run = 1
        }
        if run > 3 { v.parallel_limit = false }
    }
    for bit in 1..8 { if seen & 1 << bit != 0 { v.variety += 1 } }
    v.steps = steps * 100 / (line.len - 1)
    v.contrary = if changes > 0 then contrary * 100 / changes else 0
    v.separate_climax = peaks == 1 && peak != cf_peak
    var goals = 0
    if v.steps >= 60 { goals += 1 }
    if v.contrary >= 50 { goals += 1 }
    if v.separate_climax { goals += 1 }
    if v.parallel_limit { goals += 1 }
    if v.variety >= 3 { goals += 1 }
    var total_goals = 5
    if book == 5 {
        let (values, share) = rhythm_style(beats)
        total_goals = 7
        if values >= 3 { goals += 1 }
        if share >= 10 { goals += 1 }
    }
    if v.breaks.len == 0 {
        v.stars = if goals == total_goals then 3 else if goals >= 3 then 2 else 1
    }
    v
}

/// Search evidence includes exhaustion, not just successful answers.
pub struct Solution {
    notes: List[theory.Pitch],
    beats: List[rhythm.Beat],
    nodes: int,
    stars: int,
    leaves: int,
    nearest: int,
    reasons: str,
}

fn prefix_melody(cp: List[theory.Pitch], beats: List[rhythm.Beat], limit: int) -> bool {
    var line = List[theory.Pitch]()
    for i in 0..cp.len { if !beats[i].rest && !beats[i].tied { (mut line).push(copy cp[i]) } }
    if line.len < 2 { return true }
    if !theory.prefix_with_leaps(line, limit) { return false }
    var lo = 100, hi = 0
    for p in line {
        let n = theory.position(p)
        if n < lo { lo = n }
        if n > hi { hi = n }
    }
    hi - lo <= 9
}

fn search(
    cf: List[theory.Pitch],
    mut cp: List[theory.Pitch],
    mut beats: List[rhythm.Beat],
    mode: int,
    below: bool,
    book: int,
    budget: int,
    limit: int,
    goal: int,
    peak_index: int,
    peak_pitch: int,
    mut result: Solution,
) {
    if result.nodes >= budget || result.stars >= goal { return }
    result.nodes += 1
    let i = cp.len
    if i == beats.len {
        result.leaves += 1
        region judge {
            let v = check(cf, cp, beats, mode, below, book)
            if v.breaks.len < result.nearest {
                result.nearest = v.breaks.len
                var why = ""
                for b in v.breaks { why += " {b.rule}" }
                result.reasons = copy why
            }
            if v.stars > result.stars {
                result.stars = v.stars
                result.notes = copy cp
                result.beats = copy beats
            }
        }
        return
    }
    let final = 28 + mode + (if below then 0 else 7)
    let base = final - (if below then 8 else 7)
    let time = rhythm.onset(beats, i)
    let bar = time / 8
    let was_tied = beats[i].tied
    let choices = if (book == 4 || book == 5) &&
        time % 8 == 0 &&
        i > 0 &&
        bar < cf.len - 1 &&
        beats[i].length == 4 &&
        beats[i - 1].length == 4 {
        2
    } else {
        1
    }
    for variant in 0..choices {
        if choices == 2 { beats[i].tied = variant == 0 }
        for rank in 0..30 {
            var pos = base + rank
            if limit > 4 && i > 0 {
                let distance = rank / 2 + 1
                pos = theory.position(cp[i - 1]) + (if rank % 2 == 0 then -distance else distance)
            }
            if beats[i].rest { if rank > 0 { break }; pos = final }
            if beats[i].tied { if rank > 0 { break }; pos = theory.position(cp[i - 1]) }
            if pos < base || pos > base + 14 { continue }
            if peak_index >= 0 && !beats[i].rest && !beats[i].tied {
                if i == peak_index && pos != peak_pitch || i != peak_index && pos >= peak_pitch {
                    continue
                }
            }
            if bar == cf.len - 1 && pos != final && (!below || pos != final - 7) { continue }
            var p = theory.pitch(pos)
            if i == beats.len - 3 && mode == 5 && (pos == final - 2 || below && pos == final - 9) {
                p.accidental = 1
            }
            if i == beats.len - 2 &&
                (pos == final - 1 || below && pos == final - 8) &&
                theory.raises(mode) {
                p.accidental = 1
            }
            if beats[i].tied { p = copy cp[i - 1] }
            (mut cp).push(p)
            var good = false
            region prune {
                good = prefix_melody(cp, beats, limit) &&
                    vertical(cf, cp, beats, below, book, false).len == 0
            }
            if good {
                search(
                    cf,
                    mut cp,
                    mut beats,
                    mode,
                    below,
                    book,
                    budget,
                    limit,
                    goal,
                    peak_index,
                    peak_pitch,
                    mut result,
                )
            }
            let _ = (mut cp).pop() else theory.pitch(final)
            if result.nodes >= budget || result.stars >= goal { break }
        }
        if result.nodes >= budget || result.stars >= goal { break }
    }
    beats[i].tied = was_tied
}

/// Bounded independent search; every returned answer passes the public checker.
pub fn solve(cf: List[theory.Pitch], mode: int, below: bool, book: int, budget: int) -> Solution {
    solve_with_limit(cf, mode, below, book, budget, leap_limit(rhythm.pattern(book, cf.len).len), 3)
}

/// Sparse shapes are searched first; admission can stop at its explicit star goal.
pub fn solve_with_limit(
    cf: List[theory.Pitch],
    mode: int,
    below: bool,
    book: int,
    budget: int,
    limit: int,
    goal: int,
) -> Solution {
    var result = Solution {
        notes: List[theory.Pitch](),
        beats: List[rhythm.Beat](),
        nodes: 0,
        stars: 0,
        leaves: 0,
        nearest: 1000,
        reasons: "",
    }
    var cp = List[theory.Pitch](),
        beats = if book == 5 then rhythm.florid_simple(cf.len) else rhythm.pattern(book, cf.len)
    if limit > 4 {
        let final = 28 + mode + (if below then 0 else 7)
        let heights = if below then [-5, -4, 1, 2] else [1, 2, 3, 4]
        for height in heights {
            for at in [beats.len / 2, beats.len * 2 / 3] {
                let stop = if result.nodes + 10000 < budget then result.nodes + 10000 else budget
                search(
                    cf,
                    mut cp,
                    mut beats,
                    mode,
                    below,
                    book,
                    stop,
                    limit,
                    goal,
                    at,
                    final + height,
                    mut result,
                )
                if result.stars >= goal { return result }
            }
        }
    }
    search(cf, mut cp, mut beats, mode, below, book, budget, limit, goal, -1, 0, mut result)
    if (book == 2 || book == 5) && result.stars < goal {
        beats[0].rest = true
        search(cf, mut cp, mut beats, mode, below, book, budget, limit, goal, -1, 0, mut result)
    }
    result
}

/// A candidate is admitted only with an independently checked answer.
pub struct Exercise { cantus: List[theory.Pitch], proof: Solution, candidate: int }

/// The same melodic pool, cycled from the seed, on either side of the cantus.
pub fn exercise(seed: int, mode: int, below: bool, book: int) -> Exercise ! {empty} {
    exercise_goal(seed, mode, below, book, 1)?
}

/// Tutorials admit only references reaching all displayed style goals.
pub fn exercise_goal(seed: int, mode: int, below: bool, book: int, goal: int) -> Exercise ! {
    empty,
} {
    let pool = theory.candidates(mode)
    if pool.len == 0 { return empty }
    let start = (seed % pool.len + pool.len) % pool.len
    for pass in 0..2 {
        if goal == 1 && pass == 0 { continue }
        for offset in 0..pool.len {
            let index = (start + offset) % pool.len
            let limit = if pass == 0 {
                4
            } else {
                leap_limit(rhythm.pattern(book, pool[index].notes.len).len)
            }
            let proof = solve_with_limit(pool[index].notes, mode, below, book, 200000, limit, goal)
            if proof.stars >= goal {
                return Exercise { cantus: copy pool[index].notes, proof: proof, candidate: index }
            }
        }
    }
    empty
}

/// Four leaps per ten attacks, rounded upward; Book I keeps its original bound.
pub fn leap_limit(attacks: int) -> int {
    let limit = (attacks * 4 + 9) / 10
    if limit < 2 then 2 else limit
}

/// Aeolian raises its sixth only in the final 6-sharp, 7-sharp, tonic ascent.
pub fn cadential_sixth(line: List[theory.Pitch], mode: int, index: int) -> bool {
    if mode != 5 || line.len < 3 || index != line.len - 3 { return false }
    let final = theory.position(line[line.len - 1])
    theory.position(line[index]) == final - 2 &&
        line[index].accidental == 1 &&
        theory.position(line[index + 1]) == final - 1 &&
        line[index + 1].accidental == 1 &&
        line[index + 2].accidental == 0
}
