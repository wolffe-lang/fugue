//! Rhythmic layout and part text, independent of the terminal and output owner.

use rhythm
use session
use theory

/// The smallest editable unit, in eighths.
pub fn unit(book: int) -> int {
    if book == 1 then 8 else if book == 3 then 2 else if book == 5 then 1 else 4
}

/// Keep four cells per smallest subdivision plus the barline and its gutter.
pub fn bar_width(book: int) -> int { 8 / unit(book) * 4 + 2 }

/// Content width: value minimum or complete pitch/interval label, plus one gutter.
pub fn event_width(s: session.State, event: int) -> int {
    let b = copy s.beats[event]
    let minimum = if b.length >= 8 then 6 else if b.length >= 4 then 5 else 4
    let iv = theory.interval(s.cantus[rhythm.onset(s.beats, event) / 8], s.voice[event])
    let name_width = theory.name(s.voice[event]).len + 1
    let interval_width = "S{iv.quality}{iv.number}".len + 1
    var width = minimum
    if name_width > width { width = name_width }
    if interval_width > width { width = interval_width }
    // A held event needs a distinct caret cell for every editable time unit.
    let slots = (b.length + session.editor_unit(s) - 1) / session.editor_unit(s)
    if slots > width { width = slots }
    width
}

/// One boundary column plus the widths of the bar's written events.
pub fn measure_width(s: session.State, bar: int) -> int {
    var width = 1
    for i in 0..s.beats.len {
        if rhythm.onset(s.beats, i) / 8 == bar { width += event_width(s, i) }
    }
    width
}

/// Position an event by the same sum used by clipping and cursor scrolling.
pub fn event_column(s: session.State, first: int, event: int) -> int {
    var x = 9
    let first_time = first * 8
    for i in 0..event {
        let time = rhythm.onset(s.beats, i)
        if time < first_time { continue }
        x += event_width(s, i)
        if (time + s.beats[i].length) % 8 == 0 { x += 1 }
    }
    x
}

/// Scroll by bars only until the entire focused event, not just its head, fits.
pub fn first_bar(s: session.State, columns: int) -> int {
    let focus = if s.hearing >= 0 then session.event_at(s, s.hearing) else s.cursor
    let bar = rhythm.onset(s.beats, focus) / 8
    var first = 0
    while first < bar && event_column(s, first, focus) + event_width(s, focus) - 2 >= columns - 27 {
        first += 1
    }
    first
}

/// Event columns and cursor columns share exactly the same time-to-space map.
pub fn column(book: int, first: int, time: int) -> int {
    9 + (time / 8 - first) * bar_width(book) + time % 8 / unit(book) * 4
}

/// Both voices fill each bar exactly; incoming editor ties become outgoing part marks.
pub fn part(s: session.State, tempo: int) -> str {
    var text = "title Two voices\ntempo {tempo}\nmeter 4/4\npart cantus organ p pan -25\npart voice choir mp pan 25\n"
    for bar in 0..s.cantus.len {
        text += "bar {bar + 1}\ncantus {theory.name(s.cantus[bar])}/1\nvoice"
        for i in 0..s.voice.len {
            if rhythm.onset(s.beats, i) / 8 != bar { continue }
            let b = copy s.beats[i]
            text += " {if b.rest then "r" else theory.name(s.voice[i])}/{rhythm.value_name(b.length)}"
            if !b.rest && i + 1 < s.beats.len && s.beats[i + 1].tied { text += "~" }
        }
        text += "\n"
    }
    text
}
