use rhythm
use species
use theory

fn pitches(values: List[int]) -> List[theory.Pitch] {
    var out = List[theory.Pitch]()
    for n in values { (mut out).push(theory.pitch(n)) }
    out
}

fn broken(out: List[theory.Break], name: str) -> bool {
    for b in out { if b.rule == name { return true } }
    false
}

fn test_second_passing_has_direction_and_two_steps() {
    let beats = rhythm.pattern(2, 3)
    let cf = pitches([28, 28, 28])
    assert(species.classify(cf, pitches([33, 34, 35]), beats[0..3], 1, 2, false) == "passing")
    assert(species.classify(cf, pitches([33, 34, 33]), beats[0..3], 1, 2, false) == "unlicensed")
    assert(!species.passing(pitches([33, 34, 36]), beats, 1))
}

fn test_accented_parallel_is_never_accepted() {
    let cf = pitches([28, 29, 28])
    let beats = rhythm.pattern(2, 3)
    let bad = species.vertical(cf, pitches([32, 30, 33, 34, 35]), beats, false, 2, true)
    assert(broken(bad, "accented-parallel"))
    let good = species.vertical(cf, pitches([32, 30, 31, 34, 35]), beats, false, 2, true)
    assert(!broken(good, "accented-parallel"))
}

fn test_second_strong_dissonance_and_unison() {
    let cf = pitches([28, 29, 28]), beats = rhythm.pattern(2, 3)
    assert(
        broken(
            species.vertical(cf, pitches([32, 33, 30, 34, 35]), beats, false, 2, true),
            "downbeat-consonance",
        ),
    )
    assert(
        !broken(
            species.vertical(cf, pitches([32, 33, 31, 34, 35]), beats, false, 2, true),
            "downbeat-consonance",
        ),
    )
    assert(
        broken(
            species.vertical(cf, pitches([32, 33, 29, 34, 35]), beats, false, 2, true),
            "downbeat-unison",
        ),
    )
}

fn test_second_only_opening_half_can_rest() {
    let cf = pitches([28, 29, 28]), cp = pitches([32, 35, 31, 34, 35])
    var beats = rhythm.pattern(2, 3)
    beats[0].rest = true
    assert(!broken(species.vertical(cf, cp, beats, false, 2, true), "opening-rest"))
    beats[2].rest = true
    assert(broken(species.vertical(cf, cp, beats, false, 2, true), "opening-rest"))
}

fn test_second_weak_neighbour_is_refused() {
    let cf = pitches([28, 28, 28]), beats = rhythm.pattern(2, 3)
    assert(
        !broken(
            species.vertical(cf, pitches([33, 34, 35, 37, 35]), beats, false, 2, true),
            "passing-dissonance",
        ),
    )
    assert(
        broken(
            species.vertical(cf, pitches([33, 34, 33, 37, 35]), beats, false, 2, true),
            "passing-dissonance",
        ),
    )
}

fn test_cambiata_is_never_misclassified() {
    let cf = pitches([28, 29]), cp = pitches([35, 34, 32, 33, 34])
    let beats = rhythm.pattern(3, 2)
    assert(species.cambiata(cf, cp, beats, 1, false))
    assert(species.classify(cf, cp, beats, 1, 3, false) == "cambiata")
    assert(!species.cambiata(cf, pitches([35, 34, 31, 33, 34]), beats, 1, false))
    assert(!species.cambiata(cf, pitches([35, 34, 32, 33, 35]), beats, 1, false))
    assert(species.classify(cf, pitches([35, 34, 31, 33, 34]), beats, 1, 3, false) == "unlicensed")
}

fn test_third_neighbour_and_double_passing() {
    let cf = pitches([28, 28]), beats = rhythm.pattern(3, 2)
    assert(species.classify(cf, pitches([30, 31, 30, 32, 35]), beats, 1, 3, false) == "neighbour")
    assert(
        species.classify(cf, pitches([30, 31, 32, 33, 35]), beats, 1, 3, false) == "double-passing",
    )
    assert(!species.double_passing(cf, pitches([30, 31, 32, 34, 35]), beats, 1))
}

fn test_third_same_beats_do_not_hide_parallels() {
    let cf = pitches([28, 29, 28]), beats = rhythm.pattern(3, 3)
    let bad = pitches([35, 32, 33, 30, 31, 33, 34, 35, 35])
    assert(broken(species.vertical(cf, bad, beats, false, 3, true), "same-beat-parallel"))
    let good = pitches([35, 32, 33, 30, 31, 34, 34, 35, 35])
    assert(!broken(species.vertical(cf, good, beats, false, 3, true), "same-beat-parallel"))
}

fn test_suspension_resolving_up_is_never_accepted() {
    let cf = pitches([28, 29, 28]), beats = rhythm.pattern(4, 3)
    let good = pitches([35, 35, 35, 34, 35])
    assert(species.suspension(cf, good, beats, 2, false))
    assert(species.classify(cf, good, beats, 2, 4, false) == "suspension")
    let bad = pitches([35, 35, 35, 36, 35])
    assert(!species.suspension(cf, bad, beats, 2, false))
    assert(broken(species.vertical(cf, bad, beats, false, 4, true), "suspension"))
    assert(!broken(species.vertical(cf, good, beats, false, 4, true), "suspension"))
}

fn test_suspension_types_and_preparation() {
    var beats = rhythm.pattern(4, 3)
    assert(
        species.suspension(pitches([29, 30, 28]), pitches([33, 33, 33, 32, 35]), beats, 2, false),
    )
    assert(
        species.suspension(pitches([28, 29, 28]), pitches([37, 37, 37, 36, 35]), beats, 2, false),
    )
    assert(species.suspension(pitches([30, 29, 28]), pitches([28, 28, 28, 27, 28]), beats, 2, true))
    assert(
        !species.suspension(pitches([29, 29, 28]), pitches([35, 35, 35, 34, 35]), beats, 2, false),
    )
    assert(
        !species.suspension(pitches([28, 29, 28]), pitches([35, 34, 35, 34, 35]), beats, 2, false),
    )
    beats[2].tied = false
    assert(
        !species.suspension(pitches([28, 29, 28]), pitches([35, 35, 35, 34, 35]), beats, 2, false),
    )
}
