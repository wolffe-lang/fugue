use first
use grid
use notation
use progress
use session
use theory

fn write_cantus(positions: List[int], mode: int) -> session.State {
    var s = session.with_book(take session.tutorial(0, false), 7)
    for _ in 0..mode { session.step(mut s, 30) }
    while s.voice.len < positions.len { session.step(mut s, 22) }
    while s.voice.len > positions.len { session.step(mut s, 23) }
    for i in 0..positions.len {
        let delta = positions[i] - theory.position(s.voice[s.cursor])
        for _ in 0..theory.magnitude(delta) { session.step(mut s, if delta > 0 then 1 else 2) }
        if i + 1 < positions.len { session.step(mut s, 4) }
    }
    s
}

fn test_own_cantus_repeated_note_is_never_accepted() {
    var s = write_cantus([28, 28, 29, 30, 31, 30, 29, 28], 0)
    session.step(mut s, 10)
    assert(s.phase == 2 && !s.cantus_written)
    var repeated = false
    for b in session.verdict(s).breaks { if b.rule == "repeat" && b.bar == 2 { repeated = true } }
    assert(repeated)
    session.step(mut s, 10)
    assert(!s.cantus_written)
    assert(s.progress[6] == 0)
}

fn test_own_cantus_is_accepted_scored_and_becomes_the_exercise_unchanged() {
    var s = write_cantus([28, 29, 30, 28, 31, 30, 32, 30, 29, 28], 0)
    let written = copy s.voice
    session.step(mut s, 10)
    assert(session.verdict(s).breaks.len == 0)
    assert(theory.shape_measures(written).score == theory.shape(written))
    assert(theory.shape_measures(written).ascent == 4)
    assert(theory.shape_measures(written).descent == 5)
    assert(s.progress[6] == 0)
    session.step(mut s, 10)
    assert(s.cantus_written && s.phase == 1)
    for i in 0..written.len { assert(theory.name(s.cantus[i]) == theory.name(written[i])) }
    let answer = first.solve(written, 0, false)
    assert(answer.len == written.len)
    s.voice = answer
    session.step(mut s, 10)
    assert(session.score(s) > 0 && s.progress[6] == session.score(s))
}

fn test_seventh_book_title_and_progress_v2_migration() {
    var s = session.tutorial(0, true)
    session.step(mut s, 29)
    assert(s.book == 7 && !s.cantus_written && s.voice.len == 10)
    let old = progress.decode("fugue 2 1 2 3 1 2 3") else []
    assert(old.len == 7 && old[5] == 3 && old[6] == 0)
    assert(progress.format(old) == "fugue 3 1 2 3 1 2 3 0\n")
}

fn critic_rule(positions: List[int], rule: str, altered: bool) {
    var s = write_cantus(positions, 0)
    if altered { s.voice[3].accidental = 1 }
    session.step(mut s, 10)
    let breaks = session.verdict(s).breaks
    var found = false
    for i in 0..breaks.len {
        let b = copy breaks[i]
        if b.rule == rule {
            found = true
            s.cursor = i
            for tier in 0..2 {
                let frame = notation.frame(s, 120, 40, tier)
                var bytes = List[byte]()
                grid.dump_text(frame, mut bytes)
                let text = str_from_utf8(bytes) else ""
                assert(text.contains("Bar {b.bar}: {rule} /"))
                assert(text.contains("Not yet / the cantus"))
            }
        }
    }
    assert(found)
}

fn test_study_critic_length() { critic_rule([28], "length", false) }

fn test_study_critic_final() { critic_rule([29, 30, 31, 32, 33, 32, 30, 29], "final", false) }

