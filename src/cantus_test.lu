fn test_study_length_edits_and_pitch_undo_keep_selected_events() {
    var s = session.with_book(take session.tutorial(0, false), 7)
    session.step(mut s, 22)
    assert(s.voice.len == 11 && s.beats.len == 11 && s.cursor == 0)
    session.step(mut s, 11)
    assert(s.voice.len == 10 && s.beats.len == 10)
    for _ in 0..3 { session.step(mut s, 23) }
    assert(s.voice.len == 7)
    var length = false
    for b in session.verdict(s).breaks { if b.rule == "length" { length = true } }
    assert(length)
    session.step(mut s, 11)
    assert(s.voice.len == 8)
    session.step(mut s, 4)
    session.step(mut s, 1)
    assert(s.cursor == 1 && theory.position(s.voice[1]) == 29)
    session.step(mut s, 11)
    assert(s.cursor == 1 && theory.position(s.voice[1]) == 28)
}
