use answer
use counter
use exposition
use progress
use rhythm
use session
use theory

fn solve_page(mut s: session.State) {
    s.fugue.response = answer.make(s.fugue.given, s.fugue.answer_below, s.level == 2)
    s.fugue.continuation = counter.reference(s.level)
    let line = if s.fugue.editing == 0 then copy s.fugue.response else copy s.fugue.continuation
    s.voice = line.notes
    s.beats = line.beats
}

fn test_book_six_selection_keeps_old_replay_numbers() {
    assert(session.key(1054) == 26 && session.key(1118) == 27)
    assert(session.key(1053) == 20 && session.key(1098) == 21)
    assert(session.replay_start(5, 1) == 20001 && session.replay_start(6, 1) == 22001)
    var s = session.tutorial(0, true)
    session.step(mut s, 26)
    assert(s.book == 6 && s.phase == 1)
    assert(s.progress.len == 6 && session.piece_ticks(s) == 360)
}

fn test_book_six_three_tutorials_end_and_light_the_title() {
    var s = session.with_book(take session.tutorial(0, false), 6)
    for i in 0..3 {
        assert(s.level == i && s.progress[5] == 0)
        solve_page(mut s)
        assert(session.score(s) == 3)
        session.step(mut s, 10)
        assert(s.completed[i] == 3)
        if i < 2 { assert(s.phase == 2); session.step(mut s, 12) }
    }
    assert(s.phase == 4 && s.progress[5] == 3)
    session.step(mut s, 21)
    assert(s.phase == 0 && s.progress[5] == 3)
}

fn test_voice_switch_preserves_independent_writing() {
    var s = session.with_book(take session.tutorial(2, false), 6)
    let original = copy s.voice
    s.voice[0].accidental = 1
    session.step(mut s, 27)
    assert(s.fugue.editing == 1 && s.voice[0].accidental == 0)
    s.voice[1].accidental = -1
    session.step(mut s, 27)
    assert(s.fugue.editing == 0 && s.voice[0].accidental == 1)
    assert(s.voice[1].accidental == original[1].accidental)
    assert(s.fugue.continuation.notes[1].accidental == -1)
}

fn test_exposition_clock_entries_and_part_agree() {
    var s = session.with_book(take session.tutorial(0, false), 6)
    solve_page(mut s)
    let p = exposition.written(s.fugue, s.voice, s.beats)
    let part = exposition.part(p, 240)
    assert(
        part.contains("part subject organ") &&
            part.contains("part answer choir") &&
            part.contains("part counter organ"),
    )
    assert(part.contains("bar 7\nsubject r/1\nanswer"))
    assert(part.contains("bar 12\nsubject r/1\nanswer"))
    session.step(mut s, 9)
    for i in 0..359 { session.tick(mut s) }
    assert(s.hearing == 359 && session.event_at(s, s.hearing) == 9)
    session.tick(mut s)
    assert(s.hearing == -1)
}

fn test_progress_v1_migrates_without_lighting_sixth_book() {
    let old = progress.decode("fugue 1 1 2 3 2 1") else []
    assert(old.len == 6 && old[5] == 0 && old[2] == 3)
    let fresh = progress.decode(progress.format([1, 2, 3, 2, 1, 3])) else []
    assert(fresh.len == 6 && fresh[5] == 3)
}

fn test_fugue_uses_shared_spelled_pitch_and_page_range_editor() {
    var s = session.with_book(take session.tutorial(2, false), 6)
    assert(s.range_low == 21 && s.range_high == 49 && !s.rhythm_editable)
    assert(session.editor_unit(s) == 2)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == 1)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == -1)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == 0)
    let count = s.beats.len
    session.step(mut s, 22)
    assert(s.beats.len == count)
    session.step(mut s, 27)
    assert(s.rhythm_editable && session.editor_unit(s) == 1 && s.cantus.len == 6)
    session.step(mut s, 22)
    assert(s.beats.len == count + 1 && s.beats[0].length == 2)
    session.step(mut s, 11)
    assert(s.beats.len == count && s.beats[0].length == 4)
    session.step(mut s, 28)
    assert(s.beats[0].length == 6 && s.beats[1].length == 2)
    let p = exposition.written(s.fugue, s.voice, s.beats)
    assert(exposition.part(p, 240).contains("counter F4/2."))
}

fn test_fugue_status_follows_bar_beat_and_both_voice_desks() {
    var s = session.with_book(take session.tutorial(2, false), 6)
    solve_page(mut s)
    for desk in 0..2 {
        if desk == 1 { session.step(mut s, 27) }
        for i in 0..s.voice.len {
            s.cursor = i
            s.within = 0
            let p = exposition.written(s.fugue, s.voice, s.beats)
            let v = exposition.check(p)
            let status = exposition.status(p, i, 0, v.breaks)
            let time = rhythm.onset(s.beats, i)
            assert(status.bar == time / 8 + 1 && status.beat == time % 8 + 1)
            assert(theory.position(status.pitch) == theory.position(s.voice[i]))
            for finding in status.findings { assert(finding.bar == status.bar) }
        }
    }
}

fn test_fugue_panel_findings_never_borrow_another_bar() {
    var s = session.with_book(take session.tutorial(2, false), 6)
    solve_page(mut s)
    s.voice[4].accidental += 1
    let p = exposition.written(s.fugue, s.voice, s.beats), v = exposition.check(p)
    let first = exposition.status(p, 0, 0, v.breaks)
    assert(first.figure == "tonal-mutation" && first.allowed && first.findings.len == 0)
    let bad = exposition.status(p, 4, 0, v.breaks)
    assert(bad.figure == "answer-transposition" && !bad.allowed && bad.findings.len > 0)
    for finding in bad.findings { assert(finding.bar == bad.bar) }
}
