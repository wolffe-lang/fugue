//! Curated original tutorial pages and independently checked reference answers.

use rhythm
use theory

/// A fixed cantus, rhythmic grid and test-only reference answer.
pub struct Page {
    mode: int,
    cantus: List[theory.Pitch],
    answer: List[theory.Pitch],
    beats: List[rhythm.Beat],
}

fn notes(values: List[int], sharps: List[int]) -> List[theory.Pitch] {
    var out = List[theory.Pitch]()
    for value in values { (mut out).push(theory.pitch(value)) }
    for index in sharps { out[index].accidental = 1 }
    out
}

/// Fixed pages are not seeded output; their answers are never loaded into the editor.
pub fn page(book: int, index: int) -> Page {
    var cf = List[theory.Pitch](), cp = List[theory.Pitch](), beats = List[rhythm.Beat]()
    var mode = 0
