use chapterstudy
use fuguepage
use grid
use notation
use session
use staff
use theory

fn text_has(g: grid.Grid, wanted: str) -> bool {
    var bytes = List[byte]()
    grid.dump_text(g, mut bytes)
    let text = str_from_utf8(bytes) else ""
    text.contains(wanted)
}

fn test_fugue_labels_follow_entries_on_both_sizes_and_tiers() {
    for width in [80, 120] {
        for tier in [0, 1] {
            var s = chapterstudy.solved(2)
            let rows = if width == 80 then 24 else 40
            s.hearing = 1
            let solo = fuguepage.frame(s, width, rows, tier)
            assert(text_has(solo, "Subject") && !text_has(solo, "Countersubject"))
            s.hearing = 181
            let duet = fuguepage.frame(s, width, rows, tier)
            assert(text_has(duet, "Answer") && text_has(duet, "Countersubject"))
            s.hearing = -1
            let editing = fuguepage.frame(s, width, rows, tier)
            assert(text_has(editing, "Subject") && text_has(editing, "Answer"))
            if tier == 0 { assert(grid.plain_ok(editing)) }
        }
    }
}

fn test_fugue_short_subject_uses_six_bar_editor_invariant() {
    let s = chapterstudy.solved(0)
    assert(s.cantus.len == 6 && s.fugue.given.notes.len == 10)
    assert(session.piece_ticks(s) == 360)
    assert(s.clef == session.choose_clef(s.fugue.given.notes, s.fugue.response.notes))
    let v = staff.system(s, take staff.viewport(4, 20, 25, 7, 54))
    let high = theory.pitch(40)
    assert(
        staff.label_row(v, high) <= staff.row_of(v, high) - 1 ||
            staff.label_row(v, high) == v.top - 1,
    )
}

fn test_completed_sixth_book_is_visibly_lit_on_the_title() {
    var s = chapterstudy.solved(0)
    s.phase = 0
    for t in [0, 1] {
        s.progress[5] = 0
        let dark = notation.frame(s, 80, 24, t)
        s.progress[5] = 3
        let lit = notation.frame(s, 80, 24, t)
        let at = 18 * 80 + 33
        assert(dark.cells[at].bg != lit.cells[at].bg)
        assert(lit.cells[at].bg == (if t == 1 then 222 else 11))
    }
}

fn common_panel(desk: int, width: int) {
    var s = chapterstudy.solved(2)
    s.voice[4].accidental = 0
    if desk == 1 { session.step(mut s, 27) }
    for t in [0, 1] {
        s.cursor = 0
        s.within = 0
        let rows = if width == 80 then 24 else 40
        let first = fuguepage.frame(s, width, rows, t)
        assert(text_has(first, "Editing bar 1") && text_has(first, "Bar 1, beat 1:8"))
        assert(text_has(first, "Breaks: bar 1") && !text_has(first, "bar 3 -"))
        s.cursor = 4
        s.within = 0
        let third = fuguepage.frame(s, width, rows, t)
        assert(text_has(third, "Editing bar 3") && text_has(third, "Bar 3, beat 5:8"))
        assert(text_has(third, "Breaks: bar 3") && text_has(third, "bar 3 -"))
        assert(!text_has(third, "bar 1 -"))
    }
}

fn test_fugue_answer_panel_80() { common_panel(0, 80) }

fn test_fugue_answer_panel_120() { common_panel(0, 120) }

fn test_fugue_counter_panel_80() { common_panel(1, 80) }

fn test_fugue_counter_panel_120() { common_panel(1, 120) }

fn caret_column(g: grid.Grid) -> int {
    var found = -1
    for y in 0..g.rows {
        for x in 0..g.cols - 24 {
            if g.cells[y * g.cols + x].cp == 94 { assert(found == -1); found = x }
        }
    }
    assert(found >= 0)
    found
}

fn test_fugue_right_selects_the_event_up_will_edit() {
    var s = chapterstudy.solved(2)
    let first = theory.position(s.voice[0]), second = theory.position(s.voice[1])
    session.step(mut s, 4)
    assert(session.selection(s).event == 1 && session.selection(s).within == 0)
    assert(caret_column(fuguepage.frame(s, 80, 24, 0)) == 14)
    session.step(mut s, 1)
    assert(theory.position(s.voice[0]) == first && theory.position(s.voice[1]) == second + 1)
}

fn test_fugue_cursor_never_selects_the_other_voices_slot() {
    var s = chapterstudy.solved(2)
    session.step(mut s, 27)
    session.step(mut s, 23)
    assert(s.beats[0].length == 8)
    assert(caret_column(fuguepage.frame(s, 80, 24, 0)) == 9)
    session.step(mut s, 4)
    assert(session.selection(s).event == 1 && session.selection(s).time == 8)
    assert(caret_column(fuguepage.frame(s, 80, 24, 0)) == 20)
}

fn test_fugue_overflow_mark_is_not_an_extra_cursor() {
    var s = chapterstudy.solved(2)
    s.voice[0] = theory.pitch(21)
    s.voice[s.voice.len - 1] = theory.pitch(49)
    s.cursor = s.voice.len - 1
    let g = fuguepage.frame(s, 120, 40, 0)
    let x = caret_column(g)
    assert(x >= 0 && text_has(g, "!"))
}
