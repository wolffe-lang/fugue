//! One manuscript page, shared geometry on rich and plain terminals.

use draw
use first
use grid
use session
use theory
use tier
use world

/// Colour carries consonance, while the letter remains readable without colour.
pub fn harmony_ink(cls: int, t: int) -> int {
    if t == tier.PLAIN {
        return match cls {
            0 => 2,
            1 => 3,
            _ => 1,
        }
    }
    match cls {
        0 => 22,
        1 => 130,
        _ => 124,
    }
}

/// All non-ASCII marks this renderer may draw.
pub fn glyphs() -> List[int] { [0x00b7, 0x2500, 0x2502, 0x25cb, 0x25cf, 0x2588] }

/// The minimum readable manuscript width.
pub fn minimum_columns() -> int { 80 }

fn text(mut g: grid.Grid, y: int, x: int, words: str, fg: int, bg: int, bold: bool) {
    draw.put_text(mut g, y, x, words, grid.cell(32, fg, bg, if bold then 1 else 0))
}

fn ornament(mut g: grid.Grid, y: int, x: int, t: int, bg: int) {
    let rows = [
        "  +-------+",
        "  |FFFFF  |",
        "  |FF    .|",
        "  |FFFF   |",
        "  |FF  .  |",
        "  |FF     |",
        "  +-------+",
    ]
    for row in 0..rows.len {
        for col in 0..rows[row].len {
            let ch = rows[row].bytes()[col] as int
            if ch == 70 {
                grid.put(
                    mut g,
                    y + row,
                    x + col,
                    grid.cell(if t == 1 then 0x2588 else 35, if t == 1 then 24 else 4, bg, 1),
                )
            } else if ch != 32 {
                grid.put(mut g, y + row, x + col, grid.cell(ch, if t == 1 then 130 else 3, bg, 0))
            }
        }
    }
}

/// Draw a diagnostic clef alternative in the same reserved left margin.
pub fn clef(mut g: grid.Grid, top: int, t: int, bg: int) {
    let shape = ["  /", " /|", "( |", " \"|", " /|", "( @)", " \\|", "  |", " ( )"]
    for i in 0..shape.len { text(mut g, top + i, 1, shape[i], if t == 1 then 94 else 3, bg, false) }
}

/// A shared diatonic viewport; base is the pitch position at bottom.
pub struct Viewport { top: int, bottom: int, base: int, left: int, right: int, line: int }

/// Fit five lines into a supplied pitch window, without compressing pitch steps.
pub fn viewport(top: int, bottom: int, base: int, left: int, right: int) -> Viewport {
    assert(bottom - top >= 10)
    Viewport { top: top, bottom: bottom, base: base, left: left, right: right, line: base + 2 }
}

/// Pitch and row are inverses; accidentals share their natural letter's row.
pub fn row_of(v: Viewport, p: theory.Pitch) -> int { v.bottom - (theory.position(p) - v.base) }

/// Return the natural pitch named by this viewport row.
pub fn pitch_of(v: Viewport, row: int) -> theory.Pitch { theory.pitch(v.base + v.bottom - row) }

/// Saturated burnt orange against parchment; the player's ink remains blue.
pub fn cantus_ink(t: int) -> int { if t == 1 then 130 else 1 }

/// Dark blue distinguishes the editable voice.
pub fn player_ink(t: int) -> int { if t == 1 then 24 else 4 }

/// Five unbroken runs, before bars and noteheads cross them.
pub fn lines(mut g: grid.Grid, v: Viewport, t: int) {
    for line in 0..5 {
        let y = row_of(v, theory.pitch(v.line + line * 2))
        for x in v.left..v.right + 1 {
            let bg = g.cells[y * g.cols + x].bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(if t == 1 then 0x2500 else 45, if t == 1 then 180 else 8, bg, 0),
            )
        }
    }
}

/// Draw names and crossing bar lines for supplied columns, on the same pitch space.
pub fn draw_staff(mut g: grid.Grid, v: Viewport, t: int, bars: List[int]) {
    lines(mut g, v, t)
    let bg = if t == 1 then 230 else 7
    for y in v.top..v.bottom + 1 {
        let p = pitch_of(v, y)
        text(mut g, y, 1, theory.name(p), if t == 1 then 94 else 3, bg, theory.position(p) == 28)
    }
    for x in bars {
        for pos in v.line..v.line + 9 {
            let y = row_of(v, theory.pitch(pos))
            let ground = g.cells[y * g.cols + x].bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(if t == 1 then 0x2502 else 124, if t == 1 then 180 else 8, ground, 0),
            )
        }
    }
}

/// Three-cell ledgers only beyond the five lines; never erase a crossing bar.
/// Return the true row, including when an overflow mark is drawn at an edge.
pub fn ledger(mut g: grid.Grid, v: Viewport, p: theory.Pitch, x: int, t: int, cantus: bool) -> int {
    let y = row_of(v, p)
    let ink = if cantus then cantus_ink(t) else player_ink(t)
    if y < v.top || y > v.bottom {
        let edge = if y < v.top then v.top else v.bottom
        let bg = g.cells[edge * g.cols + x].bg
        grid.put(mut g, edge, x, grid.cell(if y < v.top then 94 else 118, ink, bg, 1))
        return y
    }
    let pos = theory.position(p)
    let low = if pos < v.line then pos else v.line + 10
    let high = if pos < v.line then v.line - 2 else pos
    for step in low..high + 1 {
        let ly = row_of(v, theory.pitch(step))
        if (step - v.line) % 2 == 0 && ly >= v.top && ly <= v.bottom {
            for dx in -1..2 {
                let cell = copy g.cells[ly * g.cols + x + dx]
                if cell.cp != 0x2502 &&
                    cell.cp != 124 &&
                    cell.cp != 0x25cb &&
                    cell.cp != 0x25cf &&
                    cell.cp != 111 &&
                    cell.cp != 42 {
                    grid.put(
                        mut g,
                        ly,
                        x + dx,
                        grid.cell(if t == 1 then 0x2500 else 45, ink, cell.bg, 0),
                    )
                }
            }
        }
    }
    y
}

/// Place a hollow cantus or filled player head; callers may attach stems/ties at the returned row.
pub fn head(
    mut g: grid.Grid,
    v: Viewport,
    p: theory.Pitch,
    x: int,
    t: int,
    cantus: bool,
    selected: bool,
    lit: bool,
) -> int {
    let y = ledger(mut g, v, p, x, t, cantus)
    if y < v.top || y > v.bottom { return y }
    let cell = copy g.cells[y * g.cols + x]
    let cp = if cantus then (if t == 1 then 0x25cb else 111) else (if t == 1 then 0x25cf else 42)
    grid.put(
        mut g,
        y,
        x,
        grid.cell(
            cp,
            if cantus then cantus_ink(t) else player_ink(t),
            if lit then (if t == 1 then 222 else 11) else cell.bg,
            if selected || lit then 1 else 0,
        ),
    )
    if p.accidental == 1 {
        let old = copy g.cells[y * g.cols + x - 1]
        // A preceding cantus head or a boundary is never replaced by the accidental.
        let ax = if old.cp == 0x25cb || old.cp == 111 || old.cp == 0x2502 || old.cp == 124 {
            x + 1
        } else {
            x - 1
        }
        grid.put(mut g, y, ax, grid.cell(35, player_ink(t), cell.bg, 0))
    }
    y
}

/// Draw the manuscript with names or the experimental cell-drawn clef.
pub fn study(s: session.State, cols: int, rows: int, t: int, drawn_clef: bool) -> grid.Grid {
    var g = grid.new(rows, cols)
    let bg = if t == tier.RICH then 230 else 7
    let ink = if t == tier.RICH then 94 else 3
    let blue = if t == tier.RICH then 24 else 4
    for y in 0..rows {
        let grain = world.noise(s.seed, 19, y * 7)
        for x in 0..cols {
            let mark = world.hash(s.seed, y, x, 53) < 2
            let ground = if t == 1 && world.hash(s.seed, y, x, 256) < grain / 12 then 223 else bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(
                    if mark then (if t == 1 then 0x00b7 else 46) else 32,
                    if t == 1 then 180 else 3,
                    ground,
                    0,
                ),
            )
        }
    }
    if s.phase == 0 {
        ornament(mut g, rows / 2 - 5, cols / 2 - 22, t, bg)
        text(mut g, rows / 2 - 3, cols / 2 - 7, "fugue", blue, bg, true)
        text(mut g, rows / 2 - 1, cols / 2 - 7, "A second voice", ink, bg, false)
        text(mut g, rows / 2 + 1, cols / 2 - 7, "Book I / note against note", ink, bg, false)
        text(
            mut g,
            rows / 2 + 4,
            cols / 2 - 20,
            "Enter or any key to open the manuscript",
            blue,
            bg,
            false,
        )
        text(mut g, rows - 3, 4, "q or Escape leaves the desk", ink, bg, false)
        return g
    }
    let verdict = first.check(s.cantus, s.voice, s.mode, s.below)
    if s.phase == 2 {
        text(mut g, 2, 4, "Book I / the critic's card", blue, bg, true)
        let status = if verdict.breaks.len == 0 then "Legal" else "Not yet"
        text(mut g, 4, 4, "{status}    {verdict.stars} / 3 stars", blue, bg, true)
        text(
            mut g,
            6,
            4,
            "Contrary {verdict.contrary}% / 50%     Steps {verdict.steps}% / 60%",
            ink,
            bg,
            false,
        )
        text(
            mut g,
            7,
            4,
            "Climaxes apart: {verdict.separate_climax}    Short parallel runs: {verdict.parallel_limit}",
            ink,
            bg,
            false,
        )
        text(
            mut g,
            8,
            4,
            "Interval variety: {verdict.variety} / 3    Hard breaks: {verdict.breaks.len}",
            ink,
            bg,
            false,
        )
        for row in 0..rows - 13 {
            let i = s.cursor + row
            if i < verdict.breaks.len {
                let b = copy verdict.breaks[i]
                text(
                    mut g,
                    10 + row,
                    4,
                    draw.fit("Bar {b.bar}: {b.rule} / {b.reason}", cols - 8, false),
                    harmony_ink(2, t),
                    bg,
                    false,
                )
            }
        }
        if verdict.breaks.len == 0 {
            text(
                mut g,
                12,
                4,
                "The voices can stand together. Try another shape, or turn the page.",
                ink,
                bg,
                false,
            )
        }
        text(
            mut g,
            rows - 2,
            4,
            "r returns to the notes   n next page   Up/Down scroll   q quit",
            blue,
            bg,
            false,
        )
        return g
    }
    let margin = cols - (if cols >= 100 then 29 else 24)
    text(mut g, 1, 3, "fugue   /   I. Note against note", blue, bg, true)
    text(
        mut g,
        2,
        3,
        "{theory.mode_name(s.mode)}   seed {s.seed}   {if s.below then "cantus above" else "cantus below"}",
        ink,
        bg,
        false,
    )
    let top = 5 + (rows - 24) / 2
    let bottom = top + (if rows >= 25 then 14 else 13)
    let height = bottom - top
    var base = 28
    if s.below { base -= 7 }
    var low = 100, high = 0
    for p in s.cantus {
        let pos = theory.position(p)
        if pos < low { low = pos }
        if pos > high { high = pos }
    }
    for p in s.voice {
        let pos = theory.position(p)
        if pos < low { low = pos }
        if pos > high { high = pos }
    }
    if high > base + height { base = high - height }
    if low < base { base = low }
    // The window follows the edited pitch without compressing line/space spacing.
    if s.voice.len > 0 {
        let selected = theory.position(s.voice[s.cursor])
        if selected > base + height { base = selected - height }
        if selected < base { base = selected }
    }
    let width = (margin - 9) / (if s.cantus.len > 0 then s.cantus.len else 1)
    let v = viewport(top, bottom, base, 7, margin - 2)
    var bars = List[int]()
    for i in 0..s.cantus.len { (mut bars).push(7 + i * width) }
    (mut bars).push(margin - 2)
    let current = if s.hearing >= 0 then session.event_at(s, s.hearing) else s.cursor
    for y in top - 1..bottom + 1 {
        for x in 8 + current * width..7 + (current + 1) * width {
            let old = copy g.cells[y * cols + x]
            grid.put(mut g, y, x, grid.cell(old.cp, old.fg, if t == 1 then 223 else 15, old.attrs))
        }
    }
    draw_staff(mut g, v, t, bars)
    // The historical clef study is decorative, not a second pitch convention.
    if drawn_clef { clef(mut g, top + 1, t, bg) }
    for i in 0..s.cantus.len {
        let x = 8 + i * width
        text(mut g, top - 1, x, "{i + 1}", ink, bg, false)
        for which in 0..2 {
            let p = if which == 0 then copy s.cantus[i] else copy s.voice[i]
            let _ = head(
                mut g,
                v,
                p,
                x + which,
                t,
                which == 0,
                i == s.cursor,
                s.hearing >= 0 && session.event_at(s, s.hearing) == i,
            )
        }
        let iv = theory.interval(s.cantus[i], s.voice[i])
        let label = if t == 0 then (
                match iv.consonance {
                    0 => "P",
                    1 => "i",
                    _ => "x",
                }
            ) else iv.quality
        text(mut g, bottom + 2, x, "{label}{iv.number}", harmony_ink(iv.consonance, t), bg, false)
        if i == current { text(mut g, bottom + 3, x, "^", blue, bg, true) }
    }
    for y in 4..rows - 3 {
        grid.put(mut g, y, margin, grid.cell(if t == 1 then 0x2502 else 124, ink, bg, 0))
    }
    text(mut g, 4, margin + 2, "Editing bar {s.cursor + 1}", blue, bg, true)
    text(mut g, 6, margin + 2, "Selected note", blue, bg, false)
    if s.voice.len > 0 {
        text(mut g, 8, margin + 2, theory.name(s.voice[s.cursor]), blue, bg, false)
    }
    if s.hearing >= 0 {
        text(
            mut g,
            9,
            margin + 2,
            "Hearing {session.event_at(s, s.hearing) + 1}/{s.voice.len}",
            blue,
            bg,
            true,
        )
    }
    text(mut g, 10, margin + 2, "o  cantus", cantus_ink(t), bg, false)
    text(mut g, 11, margin + 2, "*  your voice", blue, bg, false)
    if verdict.breaks.len > 0 {
        let b = copy verdict.breaks[0]
        text(mut g, 16, margin + 2, "First break", ink, bg, false)
        text(mut g, 17, margin + 2, "at bar {b.bar}", harmony_ink(2, t), bg, true)
        text(
            mut g,
            18,
            margin + 2,
            draw.fit(b.rule, cols - margin - 3, false),
            harmony_ink(2, t),
            bg,
            false,
        )
    }
    text(mut g, 13, margin + 2, "P perfect", harmony_ink(0, t), bg, false)
    text(mut g, 14, margin + 2, "i imperfect", harmony_ink(1, t), bg, false)
    text(mut g, 15, margin + 2, "x dissonant", harmony_ink(2, t), bg, false)
    text(mut g, rows - 1, 3, "o cantus: burnt orange", cantus_ink(t), bg, false)
    text(mut g, rows - 1, 27, "* player: dark blue", blue, bg, false)
    text(
        mut g,
        rows - 2,
        3,
        "h hear   Space sound   Enter check   Arrows write   u undo   q quit",
        blue,
        bg,
        false,
    )
    g
}

/// Normal play uses named pitches; a drawn clef is available only in art studies.
pub fn frame(s: session.State, cols: int, rows: int, t: int) -> grid.Grid {
    study(s, cols, rows, t, false)
}
