use draw
use grid
use session
use tier
use world

/// Draw the manuscript at the requested size and glyph tier.
pub fn frame(s: session.State, cols: int, rows: int, t: int) -> grid.Grid {
    var g = grid.new(rows, cols)
    let bg = if t == tier.RICH then 230 else 7
    let ink = if t == tier.RICH then 94 else 3
    for y in 0..rows {
        for x in 0..cols {
            let mark = world.hash(s.seed, y, x, 31) == 0
            grid.put(mut g, y, x, grid.cell(if mark then 46 else 32, ink, bg, 0))
        }
    }
    draw.put_text(mut g, 1, 3, "F U G U E   /   Book I", grid.cell(32, ink, bg, 1))
    draw.put_text(mut g, 3, 3, "The staff is being prepared", grid.cell(32, ink, bg, 0))
    draw.put_text(
        mut g,
        rows - 2,
        3,
        "Arrows move | Enter checks | h hears | q quits",
        grid.cell(32, ink, bg, 0),
    )
    g
}

/// The minimum readable manuscript width.
pub fn minimum_columns() -> int { 80 }
