//! One manuscript page, shared geometry on rich and plain terminals.

use draw
use first
use grid
use session
use rhythm
use species
use theory
use tier
use world

/// Colour carries consonance, while the letter remains readable without colour.
pub fn harmony_ink(cls: int, t: int) -> int {
    if t == tier.PLAIN {
        return match cls {
            0 => 2,
            1 => 3,
            _ => 1,
        }
    }
    match cls {
        0 => 22,
        1 => 130,
        _ => 124,
    }
}

/// All non-ASCII marks this renderer may draw.
pub fn glyphs() -> List[int] {
    [0x00b7, 0x2500, 0x2502, 0x25cb, 0x25cf, 0x2588, 0x266d, 0x266f, 0x266e]
}

/// The minimum readable manuscript width.
pub fn minimum_columns() -> int { 80 }

fn text(mut g: grid.Grid, y: int, x: int, words: str, fg: int, bg: int, bold: bool) {
    draw.put_text(mut g, y, x, words, grid.cell(32, fg, bg, if bold then 1 else 0))
}

fn ornament(mut g: grid.Grid, y: int, x: int, t: int, bg: int) {
    let rows = [
        "  +-------+",
        "  |FFFFF  |",
        "  |FF    .|",
        "  |FFFF   |",
        "  |FF  .  |",
        "  |FF     |",
        "  +-------+",
    ]
    for row in 0..rows.len {
        for col in 0..rows[row].len {
            let ch = rows[row].bytes()[col] as int
            if ch == 70 {
                grid.put(
                    mut g,
                    y + row,
                    x + col,
                    grid.cell(if t == 1 then 0x2588 else 35, if t == 1 then 24 else 4, bg, 1),
                )
            } else if ch != 32 {
                grid.put(mut g, y + row, x + col, grid.cell(ch, if t == 1 then 130 else 3, bg, 0))
            }
        }
    }
}

/// Draw a diagnostic clef alternative in the same reserved left margin.
pub fn clef(mut g: grid.Grid, top: int, t: int, bg: int) {
    let shape = ["  /", " /|", "( |", " \"|", " /|", "( @)", " \\|", "  |", " ( )"]
    for i in 0..shape.len { text(mut g, top + i, 1, shape[i], if t == 1 then 94 else 3, bg, false) }
}

/// A shared diatonic viewport; base is the pitch position at bottom.
pub struct Viewport {
    top: int,
    bottom: int,
    base: int,
    left: int,
    right: int,
    line: int,
    grand: bool,
    cantus_line: int,
    voice_line: int,
}

/// A treble pitch window; clef lines are fixed even when base scrolls.
pub fn viewport(top: int, bottom: int, base: int, left: int, right: int) -> Viewport {
    assert(bottom - top >= 10)
    Viewport {
        top: top,
        bottom: bottom,
        base: base,
        left: left,
        right: right,
        line: 30,
        grand: false,
        cantus_line: 30,
        voice_line: 30,
    }
}

/// Set the page's fixed bottom line: E4 (30) or G2 (18).
pub fn with_clef(take v: Viewport, line: int) -> Viewport {
    var out = v
    assert(line == 30 || line == 18)
    out.line = line
    out.cantus_line = line
    out.voice_line = line
    out
}

/// A voice-entry label sits above its highest stem, inside the reserved header.
pub fn label_row(v: Viewport, highest: theory.Pitch) -> int {
    let row = row_of(v, highest) - 4
    if row < v.top - 1 then v.top - 1 else row
}

/// Apply a page's clefs without changing the drawing API or pitch coordinate map.
pub fn system(s: session.State, take v: Viewport) -> Viewport {
    var out = with_clef(take v, s.clef)
    out.grand = s.grand
    if s.grand {
        out.cantus_line = s.cantus_clef
        out.voice_line = s.voice_clef
        out.line = 18
        // Twenty-one pitch rows fit both staves; compact pages spend the header.
        if out.bottom - out.top < 20 {
            out.top = if out.bottom > 24 then 5 else 1
            out.bottom = out.top + 20
        }
        out.base = 18
        let focus = if s.hearing >= 0 then session.event_at(s, s.hearing) else s.cursor
        let selected = theory.position(s.voice[focus])
        if selected < out.base { out.base = selected }
        if selected > out.base + out.bottom - out.top {
            out.base = selected - (out.bottom - out.top)
        }
    }
    out
}

/// Pitch and row are inverses; accidentals share their natural letter's row.
pub fn row_of(v: Viewport, p: theory.Pitch) -> int { v.bottom - (theory.position(p) - v.base) }

/// Return the natural pitch named by this viewport row.
pub fn pitch_of(v: Viewport, row: int) -> theory.Pitch { theory.pitch(v.base + v.bottom - row) }

/// Deep red, at least 7:1 on every parchment ground; plain bright red.
pub fn cantus_ink(t: int) -> int { if t == 1 then 52 else 9 }

/// Dark blue distinguishes the editable voice.
pub fn player_ink(t: int) -> int { if t == 1 then 24 else 4 }

/// Five unbroken runs, before bars and noteheads cross them.
pub fn lines(mut g: grid.Grid, v: Viewport, t: int) {
    for line in 0..(if v.grand then 10 else 5) {
        let pos = if v.grand && line >= 5 then 30 + (line - 5) * 2 else v.line + line * 2
        let y = row_of(v, theory.pitch(pos))
        if y < v.top || y > v.bottom { continue }
        for x in v.left..v.right + 1 {
            let bg = g.cells[y * g.cols + x].bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(if t == 1 then 0x2500 else 45, if t == 1 then 180 else 8, bg, 0),
            )
        }
    }
}

/// Draw names and crossing bar lines for supplied columns, on the same pitch space.
pub fn draw_staff(mut g: grid.Grid, v: Viewport, t: int, bars: List[int]) {
    lines(mut g, v, t)
    let bg = if t == 1 then 230 else 7
    text(
        mut g,
        v.top - 1,
        1,
        if v.grand then "Grand" else if v.line == 30 then "Treble" else "Bass",
        if t == 1 then 94 else 3,
        bg,
        true,
    )
    for y in v.top..v.bottom + 1 {
        let p = pitch_of(v, y)
        text(mut g, y, 1, theory.name(p), if t == 1 then 94 else 3, bg, theory.position(p) == 28)
    }
    if v.grand {
        for line in [18, 30] {
            let row = row_of(v, theory.pitch(line + 8))
            if row >= v.top && row <= v.bottom {
                text(
                    mut g,
                    row,
                    4,
                    if line == 30 then "Tr" else "Ba",
                    if t == 1 then 94 else 3,
                    bg,
                    true,
                )
            }
        }
    }
    for x in bars {
        for pos in v.line..(if v.grand then 39 else v.line + 9) {
            let y = row_of(v, theory.pitch(pos))
            if y < v.top || y > v.bottom { continue }
            let ground = g.cells[y * g.cols + x].bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(if t == 1 then 0x2502 else 124, if t == 1 then 180 else 8, ground, 0),
            )
        }
    }
}

/// Three-cell ledgers only beyond the five lines; never erase a crossing bar.
/// Return the true row, including when an overflow mark is drawn at an edge.
pub fn ledger(mut g: grid.Grid, v: Viewport, p: theory.Pitch, x: int, t: int, cantus: bool) -> int {
    let y = row_of(v, p)
    let ink = if cantus then cantus_ink(t) else player_ink(t)
    if y < v.top || y > v.bottom {
        let edge = if y < v.top then v.top else v.bottom
        let bg = g.cells[edge * g.cols + x].bg
        grid.put(mut g, edge, x, grid.cell(if y < v.top then 94 else 118, ink, bg, 1))
        return y
    }
    let pos = theory.position(p)
    let line = if cantus then v.cantus_line else v.voice_line
    var low = if pos < line then pos else line + 10
    var high = if pos < line then line - 2 else pos
    if v.grand && line == 30 && low < 28 { low = 28 }
    if v.grand && line == 18 && high > 28 { high = 28 }
    for step in low..high + 1 {
        let ly = row_of(v, theory.pitch(step))
        if (step - line) % 2 == 0 && ly >= v.top && ly <= v.bottom {
            for dx in -1..2 {
                let cell = copy g.cells[ly * g.cols + x + dx]
                if cell.cp != 0x2502 &&
                    cell.cp != 124 &&
                    cell.cp != 0x25cb &&
                    cell.cp != 0x25cf &&
                    cell.cp != 111 &&
                    cell.cp != 42 {
                    grid.put(
                        mut g,
                        ly,
                        x + dx,
                        grid.cell(if t == 1 then 0x2500 else 45, ink, cell.bg, 0),
                    )
                }
            }
        }
    }
    y
}

/// Place a hollow cantus or filled player head; callers may attach stems/ties at the returned row.
pub fn head(
    mut g: grid.Grid,
    v: Viewport,
    p: theory.Pitch,
    x: int,
    t: int,
    cantus: bool,
    selected: bool,
    lit: bool,
) -> int {
    let y = ledger(mut g, v, p, x, t, cantus)
    if y < v.top || y > v.bottom { return y }
    let cell = copy g.cells[y * g.cols + x]
    let cp = if cantus then (if t == 1 then 0x25cb else 111) else (if t == 1 then 0x25cf else 42)
    grid.put(
        mut g,
        y,
        x,
        grid.cell(
            cp,
            if cantus then cantus_ink(t) else player_ink(t),
            if lit then (if t == 1 then 222 else 11) else cell.bg,
            if cantus || selected || lit then 1 else 0,
        ),
    )
    if p.accidental != 0 || selected {
        let old = copy g.cells[y * g.cols + x - 1]
        // A preceding cantus head or a boundary is never replaced by the accidental.
        let ax = if old.cp == 0x25cb || old.cp == 111 || old.cp == 0x2502 || old.cp == 124 {
            x + 1
        } else {
            x - 1
        }
        grid.put(
            mut g,
            y,
            ax,
            grid.cell(
                accidental(t, p.accidental),
                if cantus then cantus_ink(t) else player_ink(t),
                cell.bg,
                0,
            ),
        )
    }
    y
}

/// Draw the manuscript with names or the experimental cell-drawn clef.
pub fn study(s: session.State, cols: int, rows: int, t: int, drawn_clef: bool) -> grid.Grid {
    var g = grid.new(rows, cols)
    let bg = if t == tier.RICH then 230 else 7
    let ink = if t == tier.RICH then 94 else 3
    let blue = if t == tier.RICH then 24 else 4
    for y in 0..rows {
        let grain = world.noise(s.seed, 19, y * 7)
        for x in 0..cols {
            let mark = world.hash(s.seed, y, x, 53) < 2
            let ground = if t == 1 && world.hash(s.seed, y, x, 256) < grain / 12 then 223 else bg
            grid.put(
                mut g,
                y,
                x,
                grid.cell(
                    if mark then (if t == 1 then 0x00b7 else 46) else 32,
                    if t == 1 then 180 else 3,
                    ground,
                    0,
                ),
            )
        }
    }
    if s.phase == 0 {
        ornament(mut g, rows / 2 - 5, cols / 2 - 22, t, bg)
        text(mut g, rows / 2 - 3, cols / 2 - 7, "fugue", blue, bg, true)
        text(mut g, rows / 2 - 1, cols / 2 - 7, "A second voice", ink, bg, false)
        text(mut g, rows / 2 + 1, cols / 2 - 7, "Book I / note against note", ink, bg, false)
        text(
            mut g,
            rows / 2 + 4,
            cols / 2 - 20,
            "Enter or any key to open the manuscript",
            blue,
            bg,
            false,
        )
        text(mut g, rows - 3, 4, "q or Escape leaves the desk", ink, bg, false)
        return g
    }
    let verdict = first.check(s.cantus, s.voice, s.mode, s.below)
    if s.phase == 2 {
        text(mut g, 2, 4, "Book I / the critic's card", blue, bg, true)
        let status = if verdict.breaks.len == 0 then "Legal" else "Not yet"
        text(mut g, 4, 4, "{status}    {verdict.stars} / 3 stars", blue, bg, true)
        text(
            mut g,
            6,
            4,
            "Contrary {verdict.contrary}% / 50%     Steps {verdict.steps}% / 60%",
            ink,
            bg,
            false,
        )
        text(
            mut g,
            7,
            4,
            "Climaxes apart: {verdict.separate_climax}    Short parallel runs: {verdict.parallel_limit}",
            ink,
            bg,
            false,
        )
        text(
            mut g,
            8,
            4,
            "Interval variety: {verdict.variety} / 3    Hard breaks: {verdict.breaks.len}",
            ink,
            bg,
            false,
        )
        for row in 0..rows - 13 {
            let i = s.cursor + row
            if i < verdict.breaks.len {
                let b = copy verdict.breaks[i]
                text(
                    mut g,
                    10 + row,
                    4,
                    draw.fit("Bar {b.bar}: {b.rule} / {b.reason}", cols - 8, false),
                    harmony_ink(2, t),
                    bg,
                    false,
                )
            }
        }
        if verdict.breaks.len == 0 {
            text(
                mut g,
                12,
                4,
                "The voices can stand together. Try another shape, or turn the page.",
                ink,
                bg,
                false,
            )
        }
        text(
            mut g,
            rows - 2,
            4,
            "r returns to the notes   n next page   Up/Down scroll   q quit",
            blue,
            bg,
            false,
        )
        return g
    }
    let margin = cols - (if cols >= 100 then 29 else 24)
    text(mut g, 1, 3, "fugue   /   I. Note against note", blue, bg, true)
    text(
        mut g,
        2,
        3,
        "{theory.mode_name(s.mode)}   seed {s.seed}   {if s.below then "cantus above" else "cantus below"}",
        ink,
        bg,
        false,
    )
    var top = 5 + (rows - 24) / 2
    var bottom = top + (if rows >= 25 then 14 else 13)
    let height = bottom - top
    var base = 28
    if s.below { base -= 7 }
    var low = 100, high = 0
    for p in s.cantus {
        let pos = theory.position(p)
        if pos < low { low = pos }
        if pos > high { high = pos }
    }
    for p in s.voice {
        let pos = theory.position(p)
        if pos < low { low = pos }
        if pos > high { high = pos }
    }
    if high > base + height { base = high - height }
    if low < base { base = low }
    // The window follows the edited pitch without compressing line/space spacing.
    if s.voice.len > 0 {
        let selected = theory.position(s.voice[s.cursor])
        if selected > base + height { base = selected - height }
        if selected < base { base = selected }
    }
    let width = (margin - 9) / (if s.cantus.len > 0 then s.cantus.len else 1)
    let v = system(s, take viewport(top, bottom, base, 7, margin - 2))
    top = v.top
    bottom = v.bottom
    if top == 1 {
        for y in 0..4 { text(mut g, y, 0, " ".repeat(margin), ink, bg, false) }
    }
    var bars = List[int]()
    for i in 0..s.cantus.len { (mut bars).push(7 + i * width) }
    (mut bars).push(margin - 2)
    let current = if s.hearing >= 0 then session.event_at(s, s.hearing) else s.cursor
    for y in top - 1..bottom + 1 {
        for x in 8 + current * width..7 + (current + 1) * width {
            let old = copy g.cells[y * cols + x]
            grid.put(mut g, y, x, grid.cell(old.cp, old.fg, if t == 1 then 223 else 15, old.attrs))
        }
    }
    draw_staff(mut g, v, t, bars)
    // The historical clef study is decorative, not a second pitch convention.
    if drawn_clef {
        text(
            mut g,
            top - 1,
            1,
            if s.grand then "Grand" else if s.clef == 30 then "Treble" else "Bass",
            ink,
            bg,
            true,
        )
    }
    for i in 0..s.cantus.len {
        let x = 8 + i * width
        text(mut g, top - 1, x, "{i + 1}", ink, bg, false)
        for which in 0..2 {
            let p = if which == 0 then copy s.cantus[i] else copy s.voice[i]
            let _ = head(
                mut g,
                v,
                p,
                x + which,
                t,
                which == 0,
                i == s.cursor,
                s.hearing >= 0 && session.event_at(s, s.hearing) == i,
            )
        }
        let iv = interval_at(s, i)
        let label = if t == 0 then (
                match iv.consonance {
                    0 => "P",
                    1 => "i",
                    _ => "x",
                }
            ) else iv.quality
        let iy = interval_row(v, s.cantus[i], s.voice[i], false)
        text(mut g, iy, x, "{label}{iv.number}", harmony_ink(iv.consonance, t), bg, false)
        if i == current && iy + 1 < rows - 2 { text(mut g, iy + 1, x, "^", blue, bg, true) }
    }
    panel(mut g, s, margin, t)
    let hint = if s.grand && rows == 24 then rows - 1 else rows - 2
    text(
        mut g,
        hint,
        3,
        "h hear   Space sound   Enter check   Arrows write   u undo   q quit",
        blue,
        bg,
        false,
    )
    if hint < rows - 1 {
        text(mut g, rows - 1, 3, "o cantus: deep red", cantus_ink(t), bg, true)
        text(mut g, rows - 1, 27, "* player: dark blue", blue, bg, false)
    }
    g
}

/// Normal play uses named pitches; a drawn clef is available only in art studies.
pub fn frame(s: session.State, cols: int, rows: int, t: int) -> grid.Grid {
    study(s, cols, rows, t, false)
}

/// Harmonic labels always use the score pitches, never a screen coordinate.
pub fn interval_at(s: session.State, event: int) -> theory.Interval {
    let bar = rhythm.onset(s.beats, event) / 8
    theory.interval(s.cantus[bar], s.voice[event])
}

/// First free row below staff, notes and their lowest drawn tie/ledger element.
pub fn interval_row(v: Viewport, a: theory.Pitch, b: theory.Pitch, tied: bool) -> int {
    var lowest = row_of(v, theory.pitch(if v.grand then 18 else v.line))
    let ay = row_of(v, a), by = row_of(v, b)
    if ay > lowest { lowest = ay }
    if by > lowest { lowest = by }
    if tied && by + 2 <= v.bottom && by + 2 > lowest { lowest = by + 2 }
    if lowest > v.bottom { lowest = v.bottom }
    if lowest < v.top { lowest = v.top }
    lowest + 1
}

/// Cursor-local status and findings from the active bar only.
pub fn panel(mut g: grid.Grid, s: session.State, margin: int, t: int) {
    let bg = if t == 1 then 230 else 7
    let ink = if t == 1 then 94 else 3
    let blue = player_ink(t)
    let i = s.cursor
    let time = rhythm.onset(s.beats, i) + s.within
    let bar = time / 8
    let iv = interval_at(s, i)
    let cls = if iv.consonance == 0 {
        "perfect"
    } else if iv.consonance == 1 {
        "imperfect"
    } else {
        "dissonant"
    }
    for y in 3..g.rows - 2 { text(mut g, y, margin, "|", ink, bg, false) }
    let width = g.cols - margin - 3
    text(mut g, 4, margin + 2, "Editing bar {bar + 1}", blue, bg, true)
    text(mut g, 5, margin + 2, "Bar {bar + 1}, beat {time % 8 + 1}:8", blue, bg, true)
    text(
        mut g,
        7,
        margin + 2,
        if s.beats[i].rest then "rest" else "{iv.quality}{iv.number} {cls}",
        harmony_ink(iv.consonance, t),
        bg,
        true,
    )
    text(mut g, 8, margin + 2, theory.name(s.voice[i]), blue, bg, false)
    let figure = if s.book == 1 {
        if iv.consonance == 2 then "unlicensed" else "consonance"
    } else if s.book <= 5 {
        species.classify(s.cantus, s.voice, s.beats, i, s.book, s.below)
    } else {
        "exposition"
    }
    text(mut g, 9, margin + 2, draw.fit(figure, width, false), ink, bg, true)
    text(
        mut g,
        10,
        margin + 2,
        if time % 8 == 0 then "strong beat" else "weak beat",
        ink,
        bg,
        false,
    )
    let allowed = figure != "unlicensed" && figure != "unprepared" && figure != "unlicensed-eighth"
    text(
        mut g,
        11,
        margin + 2,
        if allowed then "Figure allowed" else "Figure not allowed",
        harmony_ink(if allowed then 0 else 2, t),
        bg,
        false,
    )
    let verdict = session.verdict(s)
    let local = if s.book >= 2 && s.book <= 5 {
        species.event_breaks(s.cantus, s.voice, s.beats, s.below, s.book, i)
    } else {
        copy verdict.breaks
    }
    var row = 12
    for b in local {
        if b.bar == bar + 1 && row < 15 {
            text(
                mut g,
                row,
                margin + 2,
                draw.fit("bar {b.bar} - {b.rule}", width, false),
                harmony_ink(2, t),
                bg,
                false,
            )
            row += 1
        }
    }
    if row == 12 { text(mut g, row, margin + 2, "No local break", blue, bg, false) }
    text(mut g, 16, margin + 2, "Breaks: bar {bar + 1}", ink, bg, true)
    row = 17
    for b in verdict.breaks {
        if b.bar != bar + 1 { continue }
        if row >= g.rows - 4 { break }
        text(
            mut g,
            row,
            margin + 2,
            draw.fit("bar {b.bar} - {b.rule}", width, false),
            harmony_ink(2, t),
            bg,
            false,
        )
        row += 1
    }
    if row == 17 { text(mut g, row, margin + 2, "No break in this bar", blue, bg, false) }
    if s.notice != "" {
        text(
            mut g,
            g.rows - 3,
            margin + 2,
            draw.fit(s.notice, width, false),
            harmony_ink(2, t),
            bg,
            true,
        )
    }
}

/// A spelled accidental cell, including an explicit natural when a note is selected.
pub fn accidental(t: int, value: int) -> int {
    if value == -1 {
        (if t == 1 then 0x266d else 98)
    } else if value == 1 {
        (if t == 1 then 0x266f else 35)
    } else {
        (if t == 1 then 0x266e else 110)
    }
}
