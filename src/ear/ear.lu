//! Prepare outside rendering; the live adapter owns only its afplay children.

use clock
use manuscript
use session
use sound
use std.env
use std.fs
use std.process
use theory

/// Cached WAV paths and child ownership, separate from deterministic editor state.
pub struct Ear {
    enabled: bool,
    dir: str,
    owned: bool,
    base: int,
    children: List[process.Child],
    serial: int,
    whole_serial: int,
    mac: bool,
}

/// Create an exclusive private WAV directory, or use the explicitly requested sink.
pub fn open(enabled: bool) -> Ear ! {io} {
    var dir = env.get("FUGUE_WAV_DIR") else ""
    let owned = dir == ""
    if enabled {
        if owned {
            let parent = env.get("TMPDIR") else "."
            dir = "{parent}/fugue-{clock.now_ns()}"
            fs.create_dir(dir) else |_| { return io }
        } else {
            fs.create_dir_all(dir) else |_| { return io }
        }
    }
    Ear {
        enabled: enabled,
        dir: dir,
        owned: owned,
        base: 0,
        children: List[process.Child](),
        serial: 0,
        whole_serial: 0,
        mac: fs.exists("/usr/bin/afplay"),
    }
}

/// One quiet choir note, a quarter second of attack and sustain, then release.
pub fn note_part(p: theory.Pitch) -> str {
    "title Audition\ntempo 240\nmeter 1/4\npart voice choir mp\nbar 1\nvoice {theory.name(p)}/4\n"
}

/// The event-list seam: Book I has one whole-note pitch per event in each voice.
/// Rhythm adds its lengths and ties here without replacing the output owner.
pub fn part(cantus: List[theory.Pitch], voice: List[theory.Pitch]) -> str {
    let tempo = 30 * 60 * 4 / session.ticks_per_whole()
    var text = "title Two voices\ntempo {tempo}\nmeter 4/4\npart cantus organ p pan -25\npart voice choir mp pan 25\n"
    for i in 0..voice.len {
        text += "bar {i + 1}\ncantus {theory.name(cantus[i])}/1\nvoice {theory.name(voice[i])}/1\n"
    }
    text
}

/// Both voices in a single score, on the session's playback clock.
pub fn whole_part(s: session.State) -> str {
    if s.book == 1 { return part(s.cantus, s.voice) }
    manuscript.part(s, 30 * 60 * 4 / session.ticks_per_whole())
}

/// Render exactly the written phrase length, at 48 kHz stereo signed PCM.
pub fn whole_pcm(s: session.State) -> List[byte] ! {io} {
    let prepared = sound.prepare(
        "fugue",
        whole_part(s),
        (session.piece_ticks(s) + 29) / 30,
    ) else |_| { return io }
    copy prepared.pcm
}

fn trace(message: str) {
    if (env.get("FUGUE_AUDIO_TRACE") else "0") == "1" { eprint(message) }
}

fn render(path: str, text: str, seconds: int) -> () ! {io} {
    let prepared = sound.prepare("fugue", text, seconds) else |_| { return io }
    let bytes = sound.wav(prepared.pcm) else |_| { return io }
    fs.write_bytes(path, bytes) else |_| { return io }
}

/// Render the supported editor register and permitted cadence sharps before playing.
pub fn prepare(mut e: Ear, s: session.State) -> () ! {io} {
    if !e.enabled { return }
    e.base = s.range_low
    let begin = clock.now_ns()
    for i in 0..s.range_high - e.base + 1 {
        region note {
            let p = theory.pitch(e.base + i)
            render("{e.dir}/note-{e.base + i}-0.wav", note_part(p), 1)?
        }
    }
    for pos in e.base..s.range_high + 1 {
        let degree = (pos - 28 - s.mode + 70) % 7
        if s.book == 6 ||
            degree == 6 && theory.raises(s.mode) ||
            degree == 5 && s.mode == 5 && s.book > 1 {
            region note {
                var p = theory.pitch(pos)
                p.accidental = 1
                render("{e.dir}/note-{pos}-1.wav", note_part(p), 1)?
                if s.book == 6 {
                    p.accidental = -1
                    render("{e.dir}/note-{pos}--1.wav", note_part(p), 1)?
                }
            }
        }
    }
    trace("sound: note-bank render_us {(clock.now_ns() - begin) / 1000} base {e.base}")
}

/// Nonblocking reap of children this process started; no host-wide wait or signals.
pub fn poll(mut e: Ear) {
    if !e.mac { return }
    loop {
        let change = process.poll() else |_| { return }
        if !change.changed { break }
        for i in 0..e.children.len {
            if e.children[i].slot == change.child.slot && !process.is_stopped(change.status) {
                trace("sound: player-end slot {change.child.slot} status {change.status.value}")
                e.children[i].slot = -1
            }
        }
    }
}

fn start(mut e: Ear, path: str) -> () ! {io} {
    e.serial += 1
    if !e.mac {
        let bytes = fs.read_bytes(path) else |_| { return io }
        fs.write_bytes(
            "{e.dir}/audition-{if e.owned then e.serial % 64 else e.serial}.wav",
            bytes,
        ) else |_| { return io }
        trace("sound: wav-sink {e.serial} {path}")
        return
    }
    poll(mut e)
    var active = 0
    for child in e.children { if child.slot >= 0 { active += 1 } }
    if active >= 32 { eprint("sound: player capacity (32 owned cues)"); return io }
    var cmd = process.command("/usr/bin/afplay")
    process.push_arg(mut cmd, path)
    let child = process.start(cmd) else |_| { return io }
    let pid = process.pid(child) else -1
    trace("sound: player-start pid {pid} slot {child.slot} {path}")
    for i in 0..e.children.len {
        if e.children[i].slot < 0 { e.children[i] = child; return }
    }
    (mut e.children).push(child)
}

/// Audition a cached pitch; preparation never happens on this path.
pub fn audition(mut e: Ear, p: theory.Pitch) -> () ! {io} {
    if !e.enabled { return }
    start(mut e, "{e.dir}/note-{theory.position(p)}-{p.accidental}.wav")?
}

/// Render and start both voices; callers reset their tick deadline after preparation.
pub fn hear(mut e: Ear, s: session.State) -> () ! {io} {
    if !e.enabled { return }
    e.whole_serial += 1
    let path = "{e.dir}/whole-{if e.owned then e.whole_serial % 3 else e.whole_serial}.wav"
    region preparation {
        let pcm = whole_pcm(s)?
        let bytes = sound.wav(pcm) else |_| { return io }
        fs.write_bytes(path, bytes) else |_| { return io }
    }
    trace("sound: whole-render {path} ticks {session.piece_ticks(s)}")
    start(mut e, path)?
}

/// Reap every owned player only after restoring the terminal; remove private files.
pub fn close(mut e: Ear) {
    for child in e.children {
        if child.slot >= 0 { let c = copy child; let _ = process.wait(take c) else -1 }
    }
    if e.owned && e.enabled { fs.remove_dir_all(e.dir) else |_| {} }
    e.enabled = false
}
