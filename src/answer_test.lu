use answer
use subject
use theory

fn test_real_answers_preserve_spelling_and_semitones_both_sides() {
    for index in 0..3 {
        let s = subject.tutorial(index)
        for below in [false, true] {
            let a = answer.make(s, below, false)
            assert(answer.check(s, a.notes, a.beats, below).kind == "Real answer")
            for i in 0..s.notes.len {
                assert(
                    theory.chromatic(a.notes[i]) - theory.chromatic(s.notes[i]) ==
                        (if below then -5 else 7),
                )
                assert(
                    theory.position(a.notes[i]) - theory.position(s.notes[i]) ==
                        (if below then -3 else 4),
                )
            }
        }
    }
}

fn test_tonal_answer_is_never_misread_as_real() {
    for index in [1, 2] {
        let s = subject.tutorial(index)
        for below in [false, true] {
            let a = answer.make(s, below, true)
            let v = answer.check(s, a.notes, a.beats, below)
            assert(v.kind == "Tonal answer")
            assert(v.mutation == (if index == 1 then 1 else 0))
            let real = answer.make(s, below, false)
            assert(answer.check(s, real.notes, real.beats, below).kind == "Real answer")
        }
    }
}

fn test_wrong_transposition_and_misplaced_mutation_name_the_bar() {
    let s = subject.tutorial(1)
    var a = answer.make(s, false, true)
    a.notes[5] = theory.pitch(theory.position(a.notes[5]) - 1)
    let v = answer.check(s, a.notes, a.beats, false)
    assert(v.kind == "refused")
    assert(v.breaks.len == 1 && v.breaks[0].rule == "answer-transposition" && v.breaks[0].bar == 4)
    a = answer.make(s, false, false)
    a.notes[1].accidental += 1
    let wrong = answer.check(s, a.notes, a.beats, false)
    assert(wrong.kind == "refused" && wrong.breaks[0].bar == 1)
    a = answer.make(s, false, false)
    a.beats[0].length = 2
    assert(answer.check(s, a.notes, a.beats, false).breaks[0].rule == "answer-rhythm")
}

fn answer_census(mode: int) {
    let pool = subject.candidates(mode)
    var count = 0
    for seed in 0..50 {
        let s = subject.choose(pool, seed) else { assert(false); return }
        let a = answer.make(s, seed % 2 == 0, false)
        assert(answer.check(s, a.notes, a.beats, seed % 2 == 0).kind == "Real answer")
        if answer.mutation(s) >= 0 {
            let t = answer.make(s, seed % 2 == 0, true)
            assert(answer.check(s, t.notes, t.beats, seed % 2 == 0).kind == "Tonal answer")
            count += 1
        }
    }
    print("answer census {theory.mode_name(mode)} real 50 tonal {count} real-only {50 - count}")
}

fn test_answer_census_ionian() { answer_census(0) }

fn test_answer_census_dorian() { answer_census(1) }

fn test_answer_census_phrygian() { answer_census(2) }

fn test_answer_census_lydian() { answer_census(3) }

fn test_answer_census_mixolydian() { answer_census(4) }

fn test_answer_census_aeolian() { answer_census(5) }
