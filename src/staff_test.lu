use grid
use rhythm
use session
use staff
use theory

fn test_dissonance_is_never_drawn_green() {
    assert(staff.harmony_ink(2, 1) == 124)
    assert(staff.harmony_ink(2, 0) == 1)
    assert(staff.harmony_ink(0, 1) == 22)
    assert(staff.harmony_ink(1, 1) == 130)
}

fn test_plain_staff_and_grain() {
    let s = session.tutorial(1, false)
    let g = staff.frame(s, 80, 24, 0)
    assert(grid.plain_ok(g))
    var dots = 0
    for c in g.cells { if c.cp == 46 { dots += 1 } }
    assert(dots > 0)
    let rich = staff.frame(s, 120, 40, 1)
    var warm = 0
    for c in rich.cells { if c.bg == 223 { warm += 1 } }
    assert(warm > 0)
}

fn test_editor_step_undo_and_octave() {
    var s = session.tutorial(1, false)
    let before = theory.position(s.voice[0])
    session.step(mut s, 1)
    assert(theory.position(s.voice[0]) == before + 1)
    assert(s.audition == 1)
    session.step(mut s, 11)
    assert(theory.position(s.voice[0]) == before)
    session.step(mut s, 5)
    assert(theory.position(s.voice[0]) == before + 7)
}

fn test_hearing_locks_edits_and_card_return_resets_the_cursor() {
    var s = session.tutorial(0, false)
    session.step(mut s, 9)
    let old = theory.position(s.voice[0])
    session.step(mut s, 1)
    assert(theory.position(s.voice[0]) == old)
    for i in 0..300 { session.tick(mut s) }
    assert(s.hearing == -1)
    session.step(mut s, 10)
    for i in 0..100 { session.step(mut s, 2) }
    session.step(mut s, 13)
    assert(s.phase == 1 && s.cursor == 0)
    session.step(mut s, 1)
    assert(theory.position(s.voice[0]) == old + 1)
}

fn test_cadence_sharp_only_at_the_leading_note() {
    var s = session.tutorial(1, false)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == 0)
    s.cursor = 8
    s.voice[8] = theory.pitch(35)
    session.step(mut s, 7)
    assert(s.voice[8].accidental == 1)
    session.step(mut s, 11)
    assert(s.voice[8].accidental == 0)
}

fn test_five_staff_lines_are_unbroken_on_both_tiers() {
    for t in 0..2 {
        for size in 0..2 {
            let cols = if size == 0 then 80 else 120
            let rows = if size == 0 then 24 else 40
            let v = staff.viewport(5, 18, 28, 7, cols - 26)
            var g = grid.new(rows, cols)
            staff.lines(mut g, v, t)
            for line in 0..5 {
                let y = staff.row_of(v, theory.pitch(v.line + line * 2))
                for x in v.left..v.right + 1 {
                    assert(g.cells[y * cols + x].cp == (if t == 1 then 0x2500 else 45))
                }
                if line < 4 {
                    for x in v.left..v.right + 1 { assert(g.cells[(y - 1) * cols + x].cp == 32) }
                }
            }
        }
    }
}

fn test_pitch_row_margin_round_trip_whole_viewport() {
    for t in 0..2 {
        for base in 21..36 {
            let v = staff.viewport(5, 18, base, 7, 54)
            var g = grid.new(24, 80)
            staff.draw_staff(mut g, v, t, [7, 54])
            for y in v.top..v.bottom + 1 {
                let expected = theory.pitch(base + 18 - y)
                let name = theory.name(expected)
                assert(theory.position(staff.pitch_of(v, y)) == theory.position(expected))
                assert(staff.row_of(v, expected) == y)
                for n in 0..name.len {
                    assert(g.cells[y * 80 + 1 + n].cp == name.bytes()[n] as int)
                }
                assert((g.cells[y * 80 + 1].attrs == 1) == (theory.position(expected) == 28))
            }
            for step in 0..9 {
                let p = theory.pitch(v.line + step)
                assert(staff.row_of(v, p) == staff.row_of(v, theory.pitch(v.line)) - step)
            }
            let ledger = theory.pitch(v.line - 2)
            let y = staff.head(mut g, v, ledger, 12, t, true, false, false)
            assert(y == staff.row_of(v, theory.pitch(v.line)) + 2)
            assert(theory.position(staff.pitch_of(v, y)) == theory.position(ledger))
            if y >= v.top && y <= v.bottom {
                assert(g.cells[y * 80 + 10].cp == 32 && g.cells[y * 80 + 14].cp == 32)
                assert(g.cells[y * 80 + 11].cp == (if t == 1 then 0x2500 else 45))
                assert(g.cells[y * 80 + 13].cp == (if t == 1 then 0x2500 else 45))
            }
        }
    }
    let classic = staff.viewport(5, 18, 28, 7, 54)
    let names = ["E4", "F4", "G4", "A4", "B4", "C5", "D5", "E5", "F5"]
    for i in 0..9 { assert(theory.name(staff.pitch_of(classic, 16 - i)) == names[i]) }
}

fn test_bar_lines_survive_every_up_down_frame() {
    for t in 0..2 {
        var s = session.tutorial(1, false)
        for n in 0..4 {
            session.step(mut s, if n < 2 then 1 else 2)
            let g = staff.frame(s, 80, 24, t)
            // All ten boundaries and the right edge have nine consecutive cells.
            for x in [7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 54] {
                var run = 0, best = 0
                for y in 5..19 {
                    if g.cells[y * 80 + x].cp == (if t == 1 then 0x2502 else 124) {
                        run += 1
                        if run > best { best = run }
                    } else {
                        run = 0
                    }
                }
                assert(best == 9)
            }
        }
    }
}

fn test_cantus_keeps_its_hollow_head_and_contrasting_ink() {
    for t in 0..2 {
        let v = staff.viewport(5, 18, 28, 7, 54)
        var g = grid.new(24, 80)
        staff.draw_staff(mut g, v, t, [7, 54])
        let y = staff.head(mut g, v, theory.pitch(32), 12, t, true, false, false)
        let cp_y = staff.head(mut g, v, theory.pitch(32), 13, t, false, true, true)
        assert(cp_y == y)
        assert(g.cells[y * 80 + 12].cp == (if t == 1 then 0x25cb else 111))
        assert(g.cells[y * 80 + 12].fg == (if t == 1 then 52 else 9))
        assert(g.cells[y * 80 + 13].cp == (if t == 1 then 0x25cf else 42))
        assert(g.cells[y * 80 + 13].fg == (if t == 1 then 24 else 4))
        assert(g.cells[y * 80 + 13].bg == (if t == 1 then 222 else 11))
    }
}

fn test_treble_second_line_is_G4_and_bass_top_is_A3() {
    for base in 18..40 {
        let treble = staff.viewport(5, 34, base, 7, 90)
        assert(theory.name(theory.pitch(treble.line)) == "E4")
        assert(theory.name(theory.pitch(treble.line + 2)) == "G4")
        assert(theory.name(staff.pitch_of(treble, staff.row_of(treble, theory.pitch(32)))) == "G4")
        let bass = staff.with_clef(take treble, 18)
        assert(theory.name(theory.pitch(bass.line + 8)) == "A3")
        assert(theory.name(staff.pitch_of(bass, staff.row_of(bass, theory.pitch(26)))) == "A3")
    }
}

fn test_editor_reaches_three_ledgers_below_without_changing_clef() {
    for book in 1..6 {
        var s = session.with_book(take session.tutorial(0, false), book)
        let clef = s.clef
        let original = theory.position(s.voice[0])
        while theory.position(s.voice[0]) > clef - 6 { session.step(mut s, 2) }
        assert(theory.position(s.voice[0]) == clef - 6)
        assert(s.clef == clef)
        session.step(mut s, 6)
        assert(theory.position(s.voice[0]) == clef - 13)
        session.step(mut s, 11)
        while theory.position(s.voice[0]) < original { session.step(mut s, 1) }
        assert(theory.position(s.voice[0]) == original && s.clef == clef)
    }
}

fn test_interval_label_uses_pitch_not_row() {
    for book in 1..6 {
        var s = session.with_book(take session.tutorial(0, false), book)
        for i in 0..s.voice.len {
            let expected = theory.interval(s.cantus[rhythm.onset(s.beats, i) / 8], s.voice[i])
            let actual = staff.interval_at(s, i)
            assert(actual.number == expected.number && actual.quality == expected.quality)
        }
        s.voice[0] = theory.pitch(24)
        let v = staff.system(s, take staff.viewport(5, 18, 24, 7, 54))
        assert(staff.interval_row(v, s.cantus[0], s.voice[0], false) > staff.row_of(v, s.voice[0]))
    }
}

fn test_grand_system_retains_both_fixed_clefs() {
    var s = session.tutorial(1, false)
    s.cantus[6] = theory.pitch(34)
    for i in 0..s.voice.len { s.voice[i] = theory.pitch(theory.position(s.cantus[i]) - 7) }
    s.clef = session.choose_clef(s.cantus, s.voice)
    s.grand = session.needs_system(s.cantus, s.voice)
    s.cantus_clef = session.choose_clef(s.cantus, s.cantus)
    s.voice_clef = session.choose_clef(s.voice, s.voice)
    assert(s.grand && s.cantus_clef == 30 && s.voice_clef == 18)
    let v = staff.system(s, take staff.viewport(5, 18, 21, 7, 54))
    var g = grid.new(24, 80)
    staff.draw_staff(mut g, v, 0, [7, 54])
    for p in [18, 20, 22, 24, 26, 30, 32, 34, 36, 38] {
        let row = staff.row_of(v, theory.pitch(p))
        assert(g.cells[row * 80 + 10].cp == 45)
    }
    assert(staff.interval_row(v, s.cantus[0], s.voice[0], false) == 22)
}

fn test_book_six_accidentals_and_page_range_are_spelled() {
    var s = session.tutorial(0, false)
    s.book = 6
    s.range_low = 21
    s.range_high = 49
    session.step(mut s, 7)
    assert(s.voice[0].accidental == 1)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == -1)
    session.step(mut s, 7)
    assert(s.voice[0].accidental == 0)
    for i in 0..30 { session.step(mut s, 1) }
    assert(theory.position(s.voice[0]) == 49)
    for i in 0..40 { session.step(mut s, 2) }
    assert(theory.position(s.voice[0]) == 21)
}
