use manuscript
use rhythm
use session
use sound
use theory

fn test_rhythm_books_fill_bars_and_close_whole() {
    for book in 1..6 {
        let beats = rhythm.pattern(book, 10)
        assert(rhythm.valid(beats, 10))
        assert(beats[beats.len - 1].length == 8)
        assert(rhythm.onset(beats, beats.len) == 80)
        assert(rhythm.at(beats, 79) == beats.len - 1)
    }
}

fn test_rhythm_rejects_crossed_bar_and_bad_duration() {
    assert(!rhythm.valid([rhythm.Beat { length: 3, rest: false, tied: false }], 1))
    assert(!rhythm.valid([rhythm.Beat { length: 8, rest: true, tied: true }], 1))
}

fn test_rhythm_fourth_has_preparation_and_ties() {
    let beats = rhythm.pattern(4, 10)
    assert(beats[0].rest && !beats[1].rest)
    assert(!beats[1].tied && beats[2].tied && !beats[3].tied)
}

fn test_later_book_minimum_unit_and_reversible_rhythm_edit() {
    var s = session.tutorial(0, false)
    s.book = 5
    s.rhythm_editable = true
    session.step(mut s, 4)
    assert(s.cursor == 0 && s.within == 1)
    session.step(mut s, 22)
    assert(s.beats[0].length == 4 && s.beats[1].length == 4)
    assert(s.voice.len == 11 && rhythm.valid(s.beats, 10))
    session.step(mut s, 11)
    assert(s.voice.len == 10 && s.beats[0].length == 8 && s.within == 1)
    session.step(mut s, 22)
    session.step(mut s, 23)
    assert(s.voice.len == 10 && s.beats[0].length == 8)
}

fn test_replay_book_namespace_preserves_old_selectors() {
    assert(session.replay_start(1, 101) == 101)
    assert(session.replay_start(2, 101) == 14101)
    assert(session.replay_start(5, 1000) == 21000)
}

fn test_rhythm_columns_round_trip_every_unit() {
    for book in 2..6 {
        let unit = manuscript.unit(book), width = manuscript.bar_width(book)
        for bar in 0..10 {
            var offset = 0
            while offset < 8 {
                let col = manuscript.column(book, 0, bar * 8 + offset)
                assert((col - 9) / width == bar)
                assert((col - 9) % width / 4 * unit == offset)
                offset += unit
            }
        }
    }
}

fn test_rhythmic_part_lengths_and_outgoing_tie() {
    var s = session.tutorial(0, false)
    s.book = 4
    s.beats = rhythm.pattern(4, 10)
    s.voice = List[theory.Pitch]()
    for i in 0..s.beats.len { (mut s.voice).push(theory.pitch(35)) }
    let part = manuscript.part(s, 240)
    assert(part.contains("voice r/2 C5/2~\nbar 2"))
    assert(part.contains("voice C5/2 C5/2~\nbar 3"))
    assert(part.ends_with("voice C5/1\n"))
    let score = sound.read(part)
    assert(score.err == "")
}

fn test_rhythm_keys_split_join_dot_tie_rest_are_undoable() {
    assert(session.key(1091) == 22 && session.key(1093) == 23 && session.key(1046) == 28)
    var s = session.with_book(take session.tutorial(0, false), 5)
    s.beats[0].rest = false
    let count = s.beats.len
    session.step(mut s, 22)
    assert(s.beats[0].length == 2 && s.beats[1].length == 2 && s.beats.len == count + 1)
    assert(rhythm.valid(s.beats, s.cantus.len))
    session.step(mut s, 28)
    assert(s.beats[0].length == 3 && s.beats[1].length == 1)
    assert(rhythm.valid(s.beats, s.cantus.len))
    assert(sound.read(manuscript.part(s, 240)).err == "")
    session.step(mut s, 11)
    assert(s.beats[0].length == 2 && s.beats[1].length == 2)
    session.step(mut s, 23)
    assert(s.beats[0].length == 4 && s.beats.len == count)
    let tied = s.beats[1].tied
    session.step(mut s, 24)
    assert(s.beats[1].tied != tied)
    session.step(mut s, 11)
    assert(s.beats[1].tied == tied)
    session.step(mut s, 13)
    assert(s.beats[0].rest)
    session.step(mut s, 13)
    assert(!s.beats[0].rest)
    session.step(mut s, 11)
    assert(s.beats[0].rest)
    let v = session.verdict(s)
    assert(v.stars == 0)
}

fn test_split_preserves_every_bar_sum() {
    var s = session.with_book(take session.tutorial(0, false), 5)
    for i in 0..s.beats.len - 1 {
        s.cursor = i
        let before = rhythm.onset(s.beats, s.beats.len)
        session.step(mut s, 22)
        assert(rhythm.onset(s.beats, s.beats.len) == before)
        assert(rhythm.valid(s.beats, s.cantus.len))
        session.step(mut s, 11)
    }
}

fn test_join_refuses_crossed_bar_by_name() {
    var s = session.with_book(take session.tutorial(0, false), 5)
    s.cursor = 1
    session.step(mut s, 23)
    assert(s.notice == "Join crosses barline")
    assert(s.history.len == 0)
}
