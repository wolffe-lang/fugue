use first
use presets
use replay
use rhythm
use species
use theory

/// A reversible single-note edit.
pub struct Edit { bar: int, within: int, notes: List[theory.Pitch], beats: List[rhythm.Beat] }

/// Deterministic editor state; no terminal or clock ownership.
pub struct State {
    book: int,
    clef: int,
    grand: bool,
    cantus_clef: int,
    voice_clef: int,
    range_low: int,
    range_high: int,
    rhythm_editable: bool,
    notice: str,
    failure: str,
    beats: List[rhythm.Beat],
    seed: int,
    cursor: int,
    within: int,
    progress: List[int],
    phase: int,
    quit: bool,
    mode: int,
    level: int,
    cantus: List[theory.Pitch],
    voice: List[theory.Pitch],
    history: List[Edit],
    hearing: int,
    audition: int,
    below: bool,
}

/// Start at the title or staff with the supplied seed.
pub fn new(seed: int, title: bool) -> State {
    let mode = (seed % 6 + 6) % 6
    let below = seed / 6 % 2 != 0
    let cantus = first.exercise(seed, mode, below) else List[theory.Pitch]()
    assert(cantus.len > 0)
    var voice = List[theory.Pitch]()
    for p in cantus {
        (mut voice).push(theory.pitch(theory.position(p) + (if below then -7 else 4)))
    }
    State {
        book: 1,
        clef: choose_clef(cantus, voice),
        grand: needs_system(cantus, voice),
        cantus_clef: choose_clef(cantus, cantus),
        voice_clef: choose_clef(voice, voice),
        range_low: lowest_pitch(),
        range_high: highest_pitch(),
        rhythm_editable: false,
        notice: "",
        failure: "",
        beats: rhythm.pattern(1, cantus.len),
        seed: seed,
        cursor: 0,
        within: 0,
        progress: [0, 0, 0, 0, 0],
        phase: if title then 0 else 1,
        quit: false,
        mode: mode,
        level: 3,
        cantus: cantus,
        voice: voice,
        history: List[Edit](),
        hearing: -1,
        audition: 0,
        below: below,
    }
}

/// Stable replay key numbers, independent of the terminal decoder.
pub fn vocab() -> replay.Vocab {
    replay.vocab(
        take [
            "",
            "up",
            "down",
            "left",
            "right",
            "octave-up",
            "octave-down",
            "sharp",
            "sound",
            "hear",
            "check",
            "undo",
            "new",
            "retry",
            "quit",
            "interrupt",
            "book-1",
            "book-2",
            "book-3",
            "book-4",
            "book-5",
            "desk",
            "split",
            "join",
            "tie",
            "rest",
            "book-6",
            "voice-switch",
            "dot",
        ],
        take List[str](),
    )
}

/// Map terminal keys to replay vocabulary; zero means unhandled.
pub fn key(n: int) -> int {
    match n {
        1..=6 => n,
        9 => 14,
        10 => 15,
        11 => 10,
        1035 => 7,
        1032 => 8,
        1104 => 9,
        1117 => 11,
        1110 => 12,
        1114 => 13,
        1113 => 14,
        1049..=1053 => n - 1033,
        1098 => 21,
        1091 => 22,
        1093 => 23,
        1116 => 24,
        1048 => 25,
        1046 => 28,
        _ => 0,
    }
}

/// One playback clock constant, shared by the cursor and part tempo.
pub fn ticks_per_whole() -> int { 30 }

/// Written phrase duration in 30 Hz ticks, independent of attack count.
pub fn piece_ticks(s: State) -> int { s.cantus.len * ticks_per_whole() }

/// Event lookup seam for rhythm: elapsed ticks map to the sounding event.
pub fn event_at(s: State, elapsed: int) -> int {
    if elapsed < 0 || elapsed >= piece_ticks(s) { return -1 }
    rhythm.at(s.beats, elapsed * 8 / ticks_per_whole())
}

/// Advance one 30 Hz replay tick; one whole note sounds for one second.
pub fn tick(mut s: State) {
    if s.hearing >= 0 { s.hearing += 1; if s.hearing >= piece_ticks(s) { s.hearing = -1 } }
}

/// Apply one replay key without reading any host state.
pub fn step(mut s: State, k: int) {
    if k == 14 || k == 15 { s.quit = true; return }
    if s.hearing >= 0 { return }
    if k == 21 { s.phase = 0; return }
    if s.phase == 0 && k >= 16 && k <= 20 {
        let progress = copy s.progress
        s = with_book(take tutorial(0, false), k - 15)
        s.progress = progress
        return
    }
    if s.phase == 0 && k != 0 { s.phase = 1; return }
    if k == 12 {
        let next = if s.level < 2 {
            tutorial(s.level + 1, false)
        } else {
            new(if s.seed == 9223372036854775807 then 0 else s.seed + 1, false)
        }
        let book = s.book
        let progress = copy s.progress
        s = if book == 1 then next else with_book(take next, book)
        s.progress = progress
        return
    }
    if k == 13 && s.phase == 1 && s.rhythm_editable { edit_rhythm(mut s, 25); return }
    if k == 13 {
        s.phase = 1
        s.cursor = 0
        s.within = 0
        return
    }
    if s.phase == 2 {
        if k == 1 && s.cursor > 0 { s.cursor -= 1 }
        if k == 2 { s.cursor += 1 }
        return
    }
    if s.phase != 1 { return }
    let unit = editor_unit(s)
    if k == 3 {
        if s.within >= unit {
            s.within -= unit
        } else if s.cursor > 0 {
            s.cursor -= 1
            s.within = s.beats[s.cursor].length - unit
        }
    }
    if k == 4 {
        if s.within + unit < s.beats[s.cursor].length {
            s.within += unit
        } else if s.cursor + 1 < s.voice.len {
            s.cursor += 1
            s.within = 0
        }
    }
    if k == 9 && s.hearing < 0 { s.hearing = 0 }
    if k == 8 { s.audition += 1 }
    if k == 10 {
        let stars = score(s)
        if stars > s.progress[s.book - 1] { s.progress[s.book - 1] = stars }
        s.phase = 2
        s.cursor = 0
        s.within = 0
    }
    if k == 11 {
        let edit = (mut s.history).pop() else { return }
        s.voice = edit.notes
        s.beats = edit.beats
        s.cursor = edit.bar
        s.within = edit.within
    }
    if k >= 22 && k <= 25 || k == 28 { edit_rhythm(mut s, k); return }
    if k >= 1 && k <= 2 || k == 5 || k == 6 || k == 7 {
        let before = copy s.voice[s.cursor]
        var next = copy before
        if k == 7 {
            let degree = (theory.position(before) - 28 - s.mode + 70) % 7
            let seventh = s.cursor == s.voice.len - 2 && degree == 6 && theory.raises(s.mode)
            let sixth = s.cursor == s.voice.len - 3 && degree == 5 && s.mode == 5 && s.book > 1
            if s.book != 6 && !seventh && !sixth { return }
            next.accidental = if s.book == 6 {
                if next.accidental == 0 then 1 else if next.accidental == 1 then -1 else 0
            } else {
                1 - next.accidental
            }
        } else {
            let delta = match k {
                1 => 1,
                2 => -1,
                5 => 7,
                _ => -7,
            }
            let pos = theory.position(before) + delta
            // Register is not a species rule: let the judge diagnose range/crossing.
            if pos < s.range_low || pos > s.range_high { return }
            next = theory.pitch(pos)
        }
        remember(mut s)
        var start = s.cursor
        while start > 0 && s.beats[start].tied { start -= 1 }
        s.voice[start] = copy next
        var end = start + 1
        while end < s.voice.len && s.beats[end].tied { s.voice[end] = copy next; end += 1 }
        s.audition += 1
        s.hearing = -1
    }
}

/// The three original tutorial cantus lines, written explicitly rather than borrowed.
pub fn tutorial(index: int, title: bool) -> State {
    let mode = if index == 0 then 0 else if index == 1 then 1 else 4
    var cf = List[theory.Pitch]()
    for d in [0, 1, 2, 0, 3, 2, 4, 2, 1, 0] { (mut cf).push(theory.pitch(28 + mode + d)) }
    var cp = List[theory.Pitch]()
    for p in cf { (mut cp).push(theory.pitch(theory.position(p) + 4)) }
    State {
        book: 1,
        clef: choose_clef(cf, cp),
        grand: needs_system(cf, cp),
        cantus_clef: choose_clef(cf, cf),
        voice_clef: choose_clef(cp, cp),
        range_low: lowest_pitch(),
        range_high: highest_pitch(),
        rhythm_editable: false,
        notice: "",
        failure: "",
        beats: rhythm.pattern(1, cf.len),
        seed: index,
        cursor: 0,
        within: 0,
        progress: [0, 0, 0, 0, 0],
        phase: if title then 0 else 1,
        quit: false,
        mode: mode,
        level: index,
        cantus: cf,
        voice: cp,
        history: List[Edit](),
        hearing: -1,
        audition: 0,
        below: false,
    }
}

/// A score is recomputed from notes, never loaded from a replay comment.
pub fn verdict(s: State) -> first.Verdict {
    if s.book == 1 { return first.check(s.cantus, s.voice, s.mode, s.below) }
    species.check(s.cantus, s.voice, s.beats, s.mode, s.below, s.book)
}

/// Recompute the score from the current notes and rhythm.
pub fn score(s: State) -> int { if s.failure != "" then 0 else verdict(s).stars }

/// Initialize from the replay's optional tutorial start selector.
pub fn from_replay(r: replay.Replay, title: bool) -> State {
    if r.start >= 14000 && r.start < 22000 {
        var old = copy r
        let book = (r.start - 10000) / 2000
        old.start = (r.start - 10000) % 2000
        return with_book(take from_replay(old, title), book)
    }
    if r.start == 99 { return tutorial(0, true) }
    if r.start >= 101 && r.start <= 103 { return tutorial(r.start - 101, true) }
    if r.start == 1000 { return new(r.seed, true) }
    if r.start >= 1 && r.start <= 3 { return tutorial(r.start - 1, title) }
    new(r.seed, title)
}

/// Install a rhythmic writing grid without supplying an answer.
pub fn with_book(take s: State, book: int) -> State {
    var next = s
    next.book = book
    next.rhythm_editable = book == 5
    if book == 1 { return next }
    if next.level < 3 {
        let page = presets.page(book, next.level)
        next.mode = page.mode
        next.cantus = page.cantus
        next.beats = page.beats
    } else {
        let e = species.exercise(next.seed, next.mode, next.below, book) else {
            next.failure = "No certified exercise within the search budget."
            next.phase = 3
            return next
        }
        next.cantus = e.cantus
        next.beats = e.proof.beats
    }
    next.voice = List[theory.Pitch]()
    for i in 0..next.beats.len {
        let bar = rhythm.onset(next.beats, i) / 8
        var p = theory.pitch(theory.position(next.cantus[bar]) + (if next.below then -7 else 4))
        if next.beats[i].tied && i > 0 { p = copy next.voice[i - 1] }
        (mut next.voice).push(p)
    }
    next.cursor = 0
    next.clef = choose_clef(next.cantus, next.voice)
    next.grand = needs_system(next.cantus, next.voice)
    next.cantus_clef = choose_clef(next.cantus, next.cantus)
    next.voice_clef = choose_clef(next.voice, next.voice)
    next
}

fn remember(mut s: State) {
    (mut s.history).push(Edit {
        bar: s.cursor,
        within: s.within,
        notes: copy s.voice,
        beats: copy s.beats,
    })
}

/// Cursor time is page-driven: free rhythm uses eighths, fixed rhythm its shortest value.
pub fn editor_unit(s: State) -> int {
    if s.rhythm_editable { return 1 }
    var unit = 8
    for b in s.beats { if b.length < unit { unit = b.length } }
    unit
}

/// Rhythm edits preserve a bar's sum and undo as one transaction; refusals are named.
fn edit_rhythm(mut s: State, k: int) {
    let i = s.cursor
    let time = rhythm.onset(s.beats, i)
    s.notice = ""
    // Fixed species retain their conventional opening-rest and incoming-barline tie.
    if !s.rhythm_editable {
        if k == 25 && (s.book == 2 || s.book == 4) && i == 0 && s.beats[0].length == 4 {
            remember(mut s)
            s.beats[0].rest = !s.beats[0].rest
            s.beats[0].tied = false
        } else if k == 24 && s.book == 4 && i > 0 && time % 8 == 0 {
            remember(mut s)
            s.beats[i].tied = !s.beats[i].tied
            if s.beats[i].tied { s.voice[i] = copy s.voice[i - 1] }
        } else {
            s.notice = "Fixed species rhythm"
        }
        return
    }
    if k == 25 {
        remember(mut s)
        s.beats[i].rest = !s.beats[i].rest
        s.beats[i].tied = false
        if i + 1 < s.beats.len { s.beats[i + 1].tied = false }
        return
    }
    if k == 24 {
        if i + 1 >= s.beats.len || s.beats[i].rest || s.beats[i + 1].rest {
            s.notice = "Tie needs two notes"
            return
        }
        remember(mut s)
        s.beats[i + 1].tied = !s.beats[i + 1].tied
        if s.beats[i + 1].tied {
            var j = i + 1
            while j < s.voice.len && s.beats[j].tied { s.voice[j] = copy s.voice[i]; j += 1 }
        }
        return
    }
    if time / 8 == s.cantus.len - 1 { s.notice = "Final whole is fixed"; return }
    let length = s.beats[i].length
    let split = k == 22
    let join = k == 23
    let dot = k == 28
    var next_length = 0
    if i + 1 < s.beats.len { next_length = s.beats[i + 1].length }
    var changed = length
    if split {
        if length % 2 != 0 || !rhythm.value(length / 2) {
            s.notice = "Cannot halve this value"
            return
        }
        changed = length / 2
    } else if join {
        if next_length == 0 || time % 8 + length + next_length > 8 {
            s.notice = "Join crosses barline"
            return
        }
        changed = length + next_length
        if !rhythm.value(changed) { s.notice = "Join is not one value"; return }
    } else if dot {
        if length != 2 && length != 4 { s.notice = "Dot needs quarter/half"; return }
        changed = length + length / 2
        if time % 8 + changed > 8 || next_length < length / 2 {
            s.notice = "No room for dot in bar"
            return
        }
        next_length -= length / 2
        if next_length != 0 && !rhythm.value(next_length) {
            s.notice = "Dot leaves invalid value"
            return
        }
    } else {
        return
    }
    remember(mut s)
    var beats = List[rhythm.Beat](), notes = List[theory.Pitch]()
    for j in 0..s.beats.len {
        if j == i + 1 && (join || dot && next_length == 0) { continue }
        var b = copy s.beats[j]
        if j == i { b.length = changed }
        if j == i + 1 && dot { b.length = next_length }
        (mut beats).push(copy b)
        (mut notes).push(copy s.voice[j])
        if j == i && split {
            b.tied = false
            (mut beats).push(b)
            (mut notes).push(copy s.voice[j])
        }
    }
    s.beats = beats
    s.voice = notes
    s.within = 0
    assert(rhythm.valid(s.beats, s.cantus.len))
}

/// Encode the same old start selector inside a book-specific namespace.
pub fn replay_start(book: int, start: int) -> int {
    if book == 1 then start else 10000 + book * 2000 + start
}

/// Select once when opening a page; edits never change the clef.
pub fn choose_clef(cantus: List[theory.Pitch], voice: List[theory.Pitch]) -> int {
    var low = 100
    for p in cantus { if theory.position(p) < low { low = theory.position(p) } }
    for p in voice { if theory.position(p) < low { low = theory.position(p) } }
    if low >= 25 then 30 else 18
}

/// The editor and pre-rendered audition bank share this explicit sounding extent.
pub fn lowest_pitch() -> int { 7 }

/// Highest sounding editor pitch, B6.
pub fn highest_pitch() -> int { 48 }

/// More than three ledgers on either side selects a grand staff at page creation.
pub fn needs_system(cantus: List[theory.Pitch], voice: List[theory.Pitch]) -> bool {
    let clef = choose_clef(cantus, voice)
    for p in cantus {
        if theory.position(p) < clef - 7 || theory.position(p) > clef + 15 { return true }
    }
    for p in voice {
        if theory.position(p) < clef - 7 || theory.position(p) > clef + 15 { return true }
    }
    false
}
