use std.env
use std.fs
use std.signal
use std.time
use clock
use ear
use first
use grid
use headless
use input
use notation
use presets
use progress
use replay
use session
use sound
use species
use staff
use studies
use term
use theory
use tier

fn has(args: List[str], word: str) -> bool {
    for a in args { if a == word { return true } }
    false
}

struct Options {
    book: int,
    seed: int,
    cols: int,
    rows: int,
    tier_id: int,
    frames: int,
    every: int,
    from: int,
    script: str,
    dump: str,
    record: str,
    apply: str,
    sound: str,
    headless: bool,
    art: bool,
    bench: bool,
    title: bool,
    trap_at: int,
    trace: bool,
}

fn options() -> Options ! {parse} {
    var o = Options {
        book: 1,
        seed: 7,
        cols: 80,
        rows: 24,
        tier_id: tier.detect(env.get("TERM") else "", env.get("LANG") else ""),
        frames: 0,
        every: 10,
        from: 0,
        script: "",
        dump: "",
        record: "",
        apply: "",
        sound: "",
        headless: false,
        art: false,
        bench: false,
        title: true,
        trap_at: -1,
        trace: false,
    }
    let args = env.args()
    var i = 0
    while i < args.len {
        let a = args[i]
        if a == "--headless" {
            o.headless = true
        } else if a == "--art-study" {
            o.art = true
        } else if a == "--bench" {
            o.bench = true
        } else if a == "--no-title" {
            o.title = false
        } else if a == "--daily" {
            o.seed = time.unix_ms() / 86400000
        } else if a == "--plain" {
            o.tier_id = 0
        } else if a == "--trace" {
            o.trace = true
        } else if a == "--mute" || a == "--no-truecolor" {} else if i + 1 < args.len {
            i += 1
            let v = args[i]
            if a == "--book" {
                o.book = v.to_int()?
            } else if a == "--seed" {
                o.seed = v.to_int()?
            } else if a == "--size" {
                let (w, h) = replay.parse_size(v)?
                o.cols = w
                o.rows = h
            } else if a == "--tier" {
                o.tier_id = tier.of_name(v)?
            } else if a == "--frames" || a == "--ticks" {
                o.frames = v.to_int()?
            } else if a == "--every" {
                o.every = v.to_int()?
            } else if a == "--from" {
                o.from = v.to_int()?
            } else if a == "--trap-at" {
                o.trap_at = v.to_int()?
            } else if a == "--script" || a == "--replay" {
                o.script = v
            } else if a == "--dump" {
                o.dump = v
            } else if a == "--record" {
                o.record = v
            } else if a == "--sound-replay" {
                o.sound = v
            } else if a == "--apply" {
                o.apply = v
            } else {
                return parse
            }
        } else {
            return parse
        }
        i += 1
    }
    if o.book < 1 || o.book > 5 { return parse }
    if o.cols < 80 || o.rows < 24 || o.every < 1 || o.frames < 0 { return parse }
    o
}

fn load(o: Options) -> replay.Replay ! {parse} {
    if o.script == "" {
        var r = replay.new(o.seed, o.tier_id, o.cols, o.rows)
        if !has(env.args(), "--seed") && !has(env.args(), "--daily") { r.start = 1 }
        r.start = session.replay_start(o.book, r.start)
        return r
    }
    let text = fs.read_text(o.script) else |_| { return parse }
    var r = replay.from_text(text, session.vocab())?
    let args = env.args()
    if has(args, "--seed") { r.seed = o.seed }
    if has(args, "--size") { r.cols = o.cols; r.rows = o.rows }
    if has(args, "--tier") || has(args, "--plain") { r.tier = o.tier_id }
    r
}

fn initial_state(o: Options, r: replay.Replay, title: bool) -> session.State {
    var s = session.from_replay(r, title)
    if o.script != "" {
        let text = fs.read_text(o.script) else ""
        for line in text.lines() {
            if line.starts_with("# books ") {
                s.progress = progress.decode(line[8..]) else copy s.progress
            }
        }
    }
    s
}

fn apply_events(mut s: session.State, r: replay.Replay, tick: int) {
    var keys = List[int]()
    let _ = replay.at(r, tick, mut keys)
    for k in keys { session.step(mut s, k) }
}

fn verify_score(o: Options, s: session.State) -> int {
    if o.script == "" { return 0 }
    let source = fs.read_text(o.script) else ""
    let expected = replay.score_of(source) else -1
    let actual = session.score(s)
    if expected >= 0 && expected != actual {
        eprint("fugue: UNVERIFIED score {actual}, claimed {expected}")
        return 1
    }
    if expected >= 0 { eprint("fugue: verified score {actual}") }
    0
}

fn offline(o: Options, r: replay.Replay) -> int {
    var s = initial_state(o, r, false)
    if s.failure != "" { eprint("fugue: {s.failure}"); return 2 }
    let count = if o.frames > 0 then o.frames else 60
    var prev = grid.new(r.rows, r.cols)
    var pen = grid.pen_new()
    var total: int = 0
    var worst: int = 0
    for tick in 0..count {
        apply_events(mut s, r, tick)
        session.tick(mut s)
        region frame {
            let begin = clock.now_ns()
            let g = notation.frame(s, r.cols, r.rows, r.tier)
            var bytes = List[byte]()
            grid.diff(prev, g, tick == 0, mut pen, mut bytes, tier.dialect(r.tier, false))
            let cost = (clock.now_ns() - begin) / 1000
            total += cost
            if cost > worst { worst = cost }
            if !o.bench && tick >= o.from && tick % o.every == 0 {
                headless.write_frame(o.dump, "frame-{headless.pad4(tick)}", g) else |_| { return 2 }
            }
            if tick == count - 1 && !o.bench {
                headless.write_frame(o.dump, "final", g) else |_| { return 2 }
            }
            for j in 0..g.cells.len { prev.cells[j] = g.cells[j] }
        }
    }
    if verify_score(o, s) != 0 { return 1 }
    if o.bench {
        print("bench {r.cols}x{r.rows} {tier.name(r.tier)} avg_us {total / count} max_us {worst}")
    }
    0
}

fn play_key(mut s: session.State, mut audio: ear.Ear, k: int, mut c: clock.Clock) {
    let before_audition = s.audition
    let before_hearing = s.hearing
    let before_level = s.level
    let before_seed = s.seed
    session.step(mut s, k)
    if before_level != s.level || before_seed != s.seed {
        ear.prepare(mut audio, s) else |_| { eprint("sound: preparation failed") }
        c = clock.new(clock.now_ns())
    }
    if s.audition != before_audition && k != 12 {
        ear.audition(mut audio, s.voice[s.cursor]) else |_| { eprint("sound: audition failed") }
    }
    if k == 9 && before_hearing < 0 && s.hearing == 0 {
        ear.hear(mut audio, s) else |_| { eprint("sound: whole failed") }
        c = clock.new(clock.now_ns())
    }
}

fn live(o: Options, r: replay.Replay) -> int {
    let enabled = !has(env.args(), "--mute") && (env.get("FUGUE_SOUND") else "1") != "0"
    var audio = ear.open(enabled) else |_| {
        eprint("fugue: cannot prepare sound directory")
        return 2
    }
    defer ear.close(mut audio)
    var s = initial_state(o, r, o.title && o.script == "")
    let state_path = env.get("FUGUE_STATE") else ".fugue-state"
    if o.script == "" {
        let text = fs.read_text(state_path) else ""
        let saved = progress.decode(text) else copy s.progress
        s.progress = saved
    }
    let initial_progress = progress.format(s.progress)
    defer {
        if o.script == "" && progress.format(s.progress) != initial_progress {
            fs.write_text(state_path, progress.format(s.progress)) else |_| {
                eprint("fugue: could not save book progress")
            }
        }
    }
    ear.prepare(mut audio, s) else |_| { eprint("fugue: note preparation failed"); return 2 }
    var t = term.open() else |e| { eprint(term.message("{e}", "fugue")); return 2 }
    if t.cols < r.cols || t.rows < r.rows {
        eprint("fugue: small (needs {r.cols}x{r.rows})")
        return 2
    }
    term.enter(mut t) else |_| { term.leave(mut t); return 2 }
    defer term.leave(mut t)
    var dec = input.new()
    var pending = List[int]()
    var c = clock.new(clock.now_ns())
    var prev = grid.new(r.rows, r.cols)
    var pen = grid.pen_new()
    var key_read_ns = clock.now_ns()
    var reason = "--ticks"
    var tick = 0
    var recorded = replay.new(r.seed, r.tier, r.cols, r.rows)
    recorded.start = r.start
    if o.title && o.script == "" {
        let old = if r.start >= 14000 then (r.start - 10000) % 2000 else r.start
        recorded.start = session.replay_start(
            s.book,
            if old >= 1 && old <= 3 then old + 100 else 1000,
        )
    }
    loop {
        let wake = clock.wait_until(mut c, clock.next_due_ns(c), term.signal_set()) else |_| {
            return 2
        }
        if wake.meaning != 0 && wake.meaning != signal.resize() {
            reason = "the interrupt"
            session.step(mut s, 15)
            replay.push_key(mut recorded, tick, 15)
        }
        if wake.input_ready {
            if pending.len == 0 { key_read_ns = clock.now_ns() }
            let bytes = term.read_keys(256) else |_| { break }
            for b in bytes { input.feed(mut dec, b, clock.now_ns() / 1000000, mut pending) }
        }
        input.flush(mut dec, clock.now_ns() / 1000000, mut pending)
        let due = clock.advance(mut c, clock.now_ns())
        if due == 0 && !s.quit { continue }
        ear.poll(mut audio)
        var carries = false
        for raw in pending {
            let k = session.key(raw)
            if k != 0 && (o.script == "" || k == 14 || k == 15) {
                if k == 14 { reason = "the quit key" }
                if k == 15 { reason = "the interrupt" }
                play_key(mut s, mut audio, k, mut c)
                replay.push_key(mut recorded, tick, k)
                carries = true
            }
        }
        pending = List[int]()
        var d = 0
        while d < due {
            if o.script != "" {
                var keys = List[int]()
                let _ = replay.at(r, tick, mut keys)
                for k in keys { play_key(mut s, mut audio, k, mut c) }
            }
            if o.trap_at == tick { assert(false) }
            session.tick(mut s)
            tick += 1
            d += 1
        }
        region frame {
            let g = notation.frame(s, r.cols, r.rows, r.tier)
            var bytes = List[byte]()
            grid.diff(prev, g, tick <= 1, mut pen, mut bytes, tier.dialect(r.tier, false))
            term.write(bytes) else |_| { return 2 }
            for j in 0..g.cells.len { prev.cells[j] = g.cells[j] }
        }
        if carries && o.trace {
            eprint(
                "trace frame {tick} carries_key inner_us {(clock.now_ns() - key_read_ns) / 1000}",
            )
        }
        if s.quit || o.frames > 0 && tick >= o.frames { break }
    }
    if o.record != "" {
        var bytes = List[byte]()
        replay.format_scored(recorded, session.vocab(), session.score(s), mut bytes)
        for byte_value in ("# books " + initial_progress).bytes() { (mut bytes).push(byte_value) }
        fs.write_bytes(o.record, bytes) else |_| { return 2 }
    }
    if verify_score(o, s) != 0 { return 1 }
    eprint("fugue: ended by {reason}")
    0
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_all(s: str, split_at: int) -> List[int] {
    var d = input.new()
    var keys = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        input.feed(mut d, bs[i], if i < split_at then 1000 else 1010, mut keys)
        i += 1
    }
    input.flush(mut d, 1010 + input.ESC_TIMEOUT_MS, mut keys)
    keys
}

fn keys_text(keys: List[int]) -> str {
    var t = ""
    for k in keys {
        t = "{t} {k}"
    }
    t
}

fn describe(seq: str) -> str {
    var t = ""
    for b in seq.bytes() {
        t = "{t} {b as int}"
    }
    "bytes{t}"
}

/// `--selftest`: the decoder's table (every terminal key, whole and split
/// at every byte) and the diff property, run on THIS binary, the tier that
/// ships. The unit tests run on the checked machine; wolf 0.2.35's release
/// tier miscompiled pack's decoder while they passed, which is why a
/// shipped binary is held to the table here. Exit 1 on any mismatch.
fn run_selftest() -> int {
    var bad = 0
    // Each row: the bytes, `|`, the keys wanted (space separated).
    var rows = List[str]()
    (mut rows).push("\x1b[A|1")
    (mut rows).push("\x1b[B|2")
    (mut rows).push("\x1b[C|4")
    (mut rows).push("\x1b[D|3")
    (mut rows).push("\x1bOA|1")
    (mut rows).push("\x1bOB|2")
    (mut rows).push("\x1b[1;2A|5")
    (mut rows).push("\x1b[1;2B|6")
    (mut rows).push("\x1b[1;2D|7")
    (mut rows).push("\x1b[1;2C|8")
    (mut rows).push("\x1b[1;5B|2")
    (mut rows).push(" |1032")
    (mut rows).push("z|1122")
    (mut rows).push("q|1113")
    (mut rows).push("\x03|10")
    (mut rows).push("\r|11")
    (mut rows).push("\x7f|12")
    (mut rows).push("\t|13")
    (mut rows).push("\x1b|9")
    (mut rows).push("\x1b |9 1032")
    (mut rows).push("\x1b[57;2u|")
    (mut rows).push("\x1b[5~|")
    (mut rows).push("\x1b[D\x1b[1;2B |3 6 1032")
    for row in rows {
        let (seq, want_raw) = row.split_once("|") else (row, "")
        let want = if want_raw.len == 0 then "" else " {want_raw}"
        var at = 0
        while at <= seq.len {
            let got = keys_text(decode_all(seq, at))
            if got != want {
                print("selftest: decoder: {describe(seq)} split at {at}: got{got}, want{want}")
                bad += 1
            }
            at += 1
        }
    }
    bad += headless.diff_property()
    if bad == 0 {
        print(
            "selftest: ok (the decoder table whole and split at every byte; the diff property over 12 frames)",
        )
        return 0
    }
    print("selftest: {bad} FAILED")
    1
}

fn main() -> int {
    let args = env.args()
    if has(args, "--help") || has(args, "-h") {
        print(
            "fugue / Books I-V\n--book 1..5   --seed N | --daily   --size WxH (minimum 80x24)   --plain   --mute\n--record FILE   --replay FILE   --ticks N\nArrows write, Shift-Up/Down octave, # cadence, Space sound, h hear, Enter check, u undo, n next, q quit.",
        )
        return 0
    }
    if has(args, "--species-verdicts") { print_raw(studies.verdicts()); return 0 }
    if has(args, "--verdicts") { print_raw(first.verdict_study()); return 0 }
    if has(args, "--version") { print("fugue 0.2.0 / Books I-V"); return 0 }
    if has(args, "--selftest") { return run_selftest() }
    if has(args, "--game-census") {
        var valid = 0, leap2 = 0, leap3 = 0, leap4 = 0
        for mode in 0..6 {
            for seed in 0..50 {
                region exercise {
                    let cf = first.exercise(seed, mode, seed % 2 == 1) else List[theory.Pitch]()
                    if cf.len == 0 || theory.validate(cf, mode).len != 0 {
                        eprint("census FAILED mode {mode} seed {seed}")
                        return 1
                    }
                    valid += 1
                    let count = theory.leaps(cf)
                    if count == 2 { leap2 += 1 }
                    if count == 3 { leap3 += 1 }
                    if count == 4 { leap4 += 1 }
                }
            }
            print("game-census {theory.mode_name(mode)} valid 50/50 length10 50")
        }
        print("game-census valid {valid}/300 leaps2 {leap2} leaps3 {leap3} leaps4 {leap4}")
        return 0
    }
    if has(args, "--solution-census") {
        for mode in 0..6 {
            let pool = theory.candidates(mode)
            for which in 0..2 {
                var solved = 0
                for seed in 0..16 {
                    region attempt {
                        let cf = theory.choose(pool, seed) else List[theory.Pitch]()
                        let cp = first.solve(cf, mode, which == 1)
                        if cp.len > 0 { solved += 1 }
                    }
                }
                print("solutions mode {mode} below {which} solved {solved}/16")
            }
        }
        return 0
    }
    if has(args, "--rhythm-audio-study") {
        for book in 2..6 {
            region audio_study {
                var s = session.with_book(take session.tutorial(0, false), book)
                let page = presets.page(book, 0)
                s.voice = page.answer
                let text = ear.whole_part(s)
                var cantus_only = "", voice_only = ""
                for line in text.lines() {
                    if !line.starts_with("voice ") { cantus_only += line + "\n" }
                    if !line.starts_with("cantus ") { voice_only += line + "\n" }
                }
                let seconds = (session.piece_ticks(s) + 29) / 30
                let both = ear.whole_pcm(s) else { return 2 }
                let a = sound.prepare("cantus-only", cantus_only, seconds) else { return 2 }
                let b = sound.prepare("voice-only", voice_only, seconds) else { return 2 }
                if both.len != seconds * 192000 || a.pcm.len != both.len || b.pcm.len != both.len {
                    return 1
                }
                var different_a = 0, different_b = 0, audible = 0
                for i in 0..both.len {
                    if both[i] != a.pcm[i] { different_a += 1 }
                    if both[i] != b.pcm[i] { different_b += 1 }
                    if both[i] != 0 as byte { audible += 1 }
                }
                if different_a == 0 || different_b == 0 || audible == 0 { return 1 }
                print(
                    "rhythm-audio book {book} ticks {session.piece_ticks(s)} bytes {both.len} differs-cantus {different_a} differs-voice {different_b} nonzero {audible}",
                )
            }
        }
        return 0
    }
    if has(args, "--species-census") {
        var book = 2
        for i in 0..args.len - 1 { if args[i] == "--book" { book = args[i + 1].to_int() else 0 } }
        if book < 2 || book > 5 { return 2 }
        var legal = 0, three = 0
        for seed in 0..12 {
            region trial {
                let mode = seed % 6, below = seed / 6 == 1
                let e = species.exercise(seed, mode, below, book) else {
                    eprint("species-census FAILED book {book} seed {seed}")
                    return 1
                }
                let v = species.check(e.cantus, e.proof.notes, e.proof.beats, mode, below, book)
                if v.stars == 0 || theory.validate(e.cantus, mode).len != 0 { return 1 }
                legal += 1
                if v.stars == 3 { three += 1 }
                print(
                    "species-census book {book} seed {seed} mode {mode} below {below} stars {v.stars} candidate {e.candidate}",
                )
            }
        }
        print("species-census book {book} legal {legal}/12 three-star-found {three}/12")
        return 0
    }
    if has(args, "--species-report") {
        var wanted = 0
        for i in 0..args.len - 1 {
            if args[i] == "--book" { wanted = args[i + 1].to_int() else -1 }
        }
        if wanted != 0 && (wanted < 2 || wanted > 5) { return 2 }
        for book in 2..6 {
            if wanted != 0 && book != wanted { continue }
            for index in 0..3 {
                let mode = if index == 0 then 0 else if index == 1 then 1 else 4
                let e = species.exercise_goal(index, mode, false, book, 3) else {
                    eprint("species EMPTY book {book} preset {index}")
                    return 1
                }
                print(
                    "preset {book} {index + 1} mode {mode} candidate {e.candidate} stars {e.proof.stars}",
                )
                print_raw("cantus")
                for p in e.cantus { print_raw(" {theory.position(p)}:{p.accidental}") }
                print("")
                print_raw("answer")
                for p in e.proof.notes { print_raw(" {theory.position(p)}:{p.accidental}") }
                print("")
                print_raw("beats")
                for b in e.proof.beats {
                    print_raw(" {b.length}:{if b.rest then 1 else 0}:{if b.tied then 1 else 0}")
                }
                print("")
            }
        }
        return 0
    }
    if has(args, "--solve-presets") {
        for mode in [0, 1, 4] {
            var cf = List[theory.Pitch]()
            for d in [0, 1, 2, 0, 3, 2, 4, 2, 1, 0] { (mut cf).push(theory.pitch(28 + mode + d)) }
            print("preset mode {mode} cantus-breaks {theory.validate(cf, mode).len}")
            let cp = first.solve(cf, mode, false)
            print("solution {cp.len}")
            for p in cp { print(theory.name(p)) }
        }
        return 0
    }
    let o = options() else |_| {
        eprint("fugue: invalid option or small size (minimum 80x24)")
        return 2
    }
    if o.apply != "" {
        let bytes = fs.read_bytes(o.apply) else |_| { return 2 }
        var out = fs.stdout()
        fs.write_chunk(mut out, headless.apply(bytes, o.cols, o.rows)) else |_| { return 2 }
        return 0
    }
    if o.dump != "" { fs.create_dir_all(o.dump) else |_| { return 2 } }
    let r = load(o) else |_| { eprint("fugue: invalid replay"); return 2 }
    if o.sound != "" {
        var s = session.from_replay(r, false)
        for tick in 0..(if o.frames > 0 then o.frames else 60) { apply_events(mut s, r, tick) }
        let pcm = ear.whole_pcm(s) else |_| { eprint("sound: replay render failed"); return 2 }
        fs.write_bytes(o.sound, pcm) else |_| { return 2 }
        return verify_score(o, s)
    }
    if o.art {
        let s = session.new(7, false)
        for t in 0..2 {
            for size in 0..2 {
                let cols = if size == 0 then 80 else 120
                let rows = if size == 0 then 24 else 40
                for variant in 0..2 {
                    let g = staff.study(s, cols, rows, t, variant == 1)
                    headless.write_frame(
                        o.dump,
                        "{if variant == 0 then "names" else "clef"}-{cols}-{tier.name(t)}",
                        g,
                    ) else |_| { return 2 }
                }
            }
        }
        return 0
    }
    if o.headless || o.bench { return offline(o, r) }
    live(o, r)
}
