use grid
use manuscript
use notation
use session

fn caret(g: grid.Grid, margin: int) -> int {
    var found = -1
    for y in 0..g.rows {
        for x in 7..margin - 2 {
            if g.cells[y * g.cols + x].cp == 94 {
                assert(found == -1, "exactly one navigation caret")
                found = y * g.cols + x
            }
        }
    }
    found
}

fn held_press(cols: int, t: int) {
    var s = session.with_book(take session.tutorial(0, false), 5)
    let rows = if cols == 80 then 24 else 40
    let before = caret(notation.frame(s, cols, rows, t), cols - 24)
    session.step(mut s, 4)
    let right = caret(notation.frame(s, cols, rows, t), cols - 24)
    assert(s.cursor == 1)
    assert(before >= 0 && right % cols == 14, "caret selects the next event attack")
    session.step(mut s, 3)
    assert(caret(notation.frame(s, cols, rows, t), cols - 24) == before)
}

fn test_cursor_same_frame_held_80_plain() { held_press(80, 0) }

fn test_cursor_same_frame_held_80_rich() { held_press(80, 1) }

fn test_cursor_same_frame_held_120_plain() { held_press(120, 0) }

fn test_cursor_same_frame_held_120_rich() { held_press(120, 1) }

fn test_cursor_has_room_for_every_subdivision() {
    var s = session.with_book(take session.tutorial(0, false), 5)
    // Wholes, halves, quarters, rests and incoming ties all reserve time cells.
    for i in 0..s.beats.len {
        s.cursor = i
        for cols in [80, 120] {
            let first = manuscript.first_bar(s, cols)
            let x = manuscript.event_column(s, first, i)
            assert(manuscript.event_width(s, i) >= s.beats[i].length)
            assert(x + s.beats[i].length - 1 < cols - 26)
        }
    }
}

fn test_cursor_retains_a_cell_on_the_compact_grand_system() {
    var s = session.with_book(take session.tutorial(0, false), 5)
    s.cursor = 1
    s.grand = true
    for t in 0..2 {
        let at = caret(notation.frame(s, 80, 24, t), 56)
        assert(at >= 0 && at % 80 == 14)
    }
}
